# syntax=docker/dockerfile:1

FROM mmltk_gcc16 AS gcc16
FROM mmltk_ubuntu AS toolchain

ARG DEBIAN_FRONTEND=noninteractive
ARG MMLTK_BINARYEN_ARCHIVE_URL=https://github.com/WebAssembly/binaryen/releases/download/version_130/binaryen-version_130-x86_64-linux.tar.gz
ARG MMLTK_BINARYEN_SHA256=0a18362361ad05465118cd8eeb72edaeec89de6894bc283576ef4e07aa3babcc
ARG MMLTK_BINARYEN_VERSION=130
ARG MMLTK_CARGO_DUPES_VERSION=0.2.1
ARG MMLTK_CLANG_VERSION=22
ARG MMLTK_CMAKE_ARCHIVE_URL=https://github.com/Kitware/CMake/releases/download/v4.4.3/cmake-4.4.3-linux-x86_64.tar.gz
ARG MMLTK_CMAKE_SHA256=d6c83076c575bc00b823522ac974bda66d0af05d6ddc30e739c12385cf32c6cc
ARG MMLTK_CMAKE_VERSION=4.4.3
ARG MMLTK_LLVM_APT_KEY_SHA256=8b2a587ffd672c4687e7581dad4b2f6c1bb2ad6b480cd9771ba2ff48e0b8c75d
ARG MMLTK_MOLD_ARCHIVE_URL=https://github.com/rui314/mold/releases/download/v2.41.0/mold-2.41.0-x86_64-linux.tar.gz
ARG MMLTK_MOLD_SHA256=a3696680d99e692970590a178bc3a33d78d60d1c6dc9db7a11b557b02b751f5d
ARG MMLTK_MOLD_VERSION=2.41.0
ARG MMLTK_NINJA_ARCHIVE_URL=https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-linux.zip
ARG MMLTK_NINJA_SHA256=5749cbc4e668273514150a80e387a957f933c6ed3f5f11e03fb30955e2bbead6
ARG MMLTK_NINJA_VERSION=1.13.2
ARG MMLTK_RUST_TOOLCHAIN=1.93.1
ARG MMLTK_TORCH_CUDA_ARCH_LIST="8.6 8.7 8.9 9.0 10.0 10.3 11.0 12.0 12.1"
ARG MMLTK_TRUNK_VERSION=0.21.14
ARG MMLTK_WASM_BINDGEN_VERSION=0.2.108

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV CC=/opt/gcc-16.2/bin/gcc \
    CXX=/opt/gcc-16.2/bin/g++ \
    CARGO_HOME=/opt/rust/cargo \
    RUSTUP_HOME=/opt/rust/rustup \
    PATH=/opt/gcc-16.2/bin:/opt/cmake-${MMLTK_CMAKE_VERSION}/bin:/opt/mold/bin:/opt/binaryen/bin:/opt/rust/cargo/bin:${PATH} \
    TORCH_CUDA_ARCH_LIST=${MMLTK_TORCH_CUDA_ARCH_LIST}

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key -o /tmp/llvm-snapshot.gpg.key \
    && echo "${MMLTK_LLVM_APT_KEY_SHA256}  /tmp/llvm-snapshot.gpg.key" | sha256sum -c - \
    && install -Dm0644 /tmp/llvm-snapshot.gpg.key /etc/apt/keyrings/apt.llvm.org.asc \
    && printf '%s\n' \
        "deb [signed-by=/etc/apt/keyrings/apt.llvm.org.asc] https://apt.llvm.org/noble/ llvm-toolchain-noble-${MMLTK_CLANG_VERSION} main" \
        >/etc/apt/sources.list.d/apt.llvm.org.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        bzip2 \
        ccache \
        clang-${MMLTK_CLANG_VERSION} \
        clang-format-${MMLTK_CLANG_VERSION} \
        clang-tidy-${MMLTK_CLANG_VERSION} \
        file \
        gdb \
        git \
        gzip \
        libasound2-dev \
        libarchive-dev \
        libavformat-dev libavcodec-dev libavutil-dev libswscale-dev \
        libcurl4-openssl-dev \
        libdbus-glib-1-dev \
        libdrm-dev \
        libegl-dev \
        libgbm-dev \
        libgtk-3-dev \
        libssl-dev \
        libturbojpeg0-dev \
        libnuma-dev \
        numactl \
        libomp-dev \
        libopenblas-dev \
        libopenmpi-dev \
        libprotobuf-dev \
        libudev-dev \
        libvulkan-dev \
        libwayland-dev \
        libx11-xcb-dev \
        libxkbcommon-dev \
        mercurial \
        nasm \
        nodejs \
        openmpi-bin \
        patch \
        pkg-config \
        procps \
        protobuf-compiler \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        software-properties-common \
        tar \
        unzip \
        xz-utils \
        yasm \
        zip \
        zstd \
    && ln -sf "/usr/bin/clang-${MMLTK_CLANG_VERSION}" /usr/local/bin/clang \
    && ln -sf "/usr/bin/clang++-${MMLTK_CLANG_VERSION}" /usr/local/bin/clang++ \
    && ln -sf "/usr/bin/clang-format-${MMLTK_CLANG_VERSION}" /usr/local/bin/clang-format \
    && ln -sf "/usr/bin/clang-tidy-${MMLTK_CLANG_VERSION}" /usr/local/bin/clang-tidy \
    && rm -f /tmp/llvm-snapshot.gpg.key \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "${MMLTK_CMAKE_ARCHIVE_URL}" -o /tmp/cmake.tar.gz \
    && echo "${MMLTK_CMAKE_SHA256}  /tmp/cmake.tar.gz" | sha256sum -c - \
    && rm -rf "/opt/cmake-${MMLTK_CMAKE_VERSION}" \
    && mkdir -p "/opt/cmake-${MMLTK_CMAKE_VERSION}" \
    && tar -xzf /tmp/cmake.tar.gz \
        --strip-components=1 \
        -C "/opt/cmake-${MMLTK_CMAKE_VERSION}" \
    && rm -f /tmp/cmake.tar.gz \
    && test "$(command -v cmake)" = "/opt/cmake-${MMLTK_CMAKE_VERSION}/bin/cmake" \
    && test "$(cmake --version | sed -n '1s/^cmake version //p')" = "${MMLTK_CMAKE_VERSION}"

RUN curl -fsSL "${MMLTK_MOLD_ARCHIVE_URL}" -o /tmp/mold.tar.gz \
    && echo "${MMLTK_MOLD_SHA256}  /tmp/mold.tar.gz" | sha256sum -c - \
    && mkdir -p /opt \
    && tar -xzf /tmp/mold.tar.gz -C /opt \
    && mv "/opt/mold-${MMLTK_MOLD_VERSION}-x86_64-linux" /opt/mold \
    && rm -f /tmp/mold.tar.gz \
    && /opt/mold/bin/mold --version

RUN curl -fsSL "${MMLTK_NINJA_ARCHIVE_URL}" -o /tmp/ninja.zip \
    && echo "${MMLTK_NINJA_SHA256}  /tmp/ninja.zip" | sha256sum -c - \
    && unzip -qo /tmp/ninja.zip -d /usr/local/bin \
    && rm -f /tmp/ninja.zip \
    && test "$(ninja --version)" = "${MMLTK_NINJA_VERSION}"

RUN curl -fsSL "${MMLTK_BINARYEN_ARCHIVE_URL}" -o /tmp/binaryen.tar.gz \
    && echo "${MMLTK_BINARYEN_SHA256}  /tmp/binaryen.tar.gz" | sha256sum -c - \
    && rm -rf /opt/binaryen \
    && tar -xzf /tmp/binaryen.tar.gz -C /opt \
    && mv "/opt/binaryen-version_${MMLTK_BINARYEN_VERSION}" /opt/binaryen \
    && rm -f /tmp/binaryen.tar.gz \
    && /opt/binaryen/bin/wasm-opt --version

COPY --link --from=gcc16 /opt/gcc-16.2 /opt/gcc-16.2
RUN printf '%s\n' /opt/gcc-16.2/lib64 >/etc/ld.so.conf.d/mmltk-gcc.conf \
    && ldconfig \
    && ln -sf /opt/gcc-16.2/bin/gcc /usr/local/bin/cc \
    && ln -sf /opt/gcc-16.2/bin/g++ /usr/local/bin/c++

COPY docker/record_compiler_evidence.py /usr/local/libexec/mmltk/record_compiler_evidence.py
RUN python3 /usr/local/libexec/mmltk/record_compiler_evidence.py --record-host-environment

COPY docker/patches/libdeflate-gcc16.patch /tmp/libdeflate-gcc16.patch
COPY docker/install_trunk.py /tmp/install_trunk.py
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${MMLTK_RUST_TOOLCHAIN}" \
    && rustup target add wasm32-unknown-unknown \
    && rustup component add rustfmt \
    && export RUSTFLAGS="-C link-arg=-fuse-ld=mold" \
    && python3 /tmp/install_trunk.py "${MMLTK_TRUNK_VERSION}" \
    && rm -f /tmp/install_trunk.py /tmp/libdeflate-gcc16.patch \
    && cargo install wasm-bindgen-cli --version "${MMLTK_WASM_BINDGEN_VERSION}" --locked \
    && cargo install cargo-dupes --version "${MMLTK_CARGO_DUPES_VERSION}" --locked \
    && unset RUSTFLAGS \
    && chmod -R a+rX "${CARGO_HOME}" "${RUSTUP_HOME}" \
    && trunk --version \
    && wasm-bindgen --version \
    && cargo dupes --version \
    && rustfmt --version

COPY src/frontend/iced/wasm-opt-wrapper /usr/local/bin/wasm-opt
RUN chmod 0755 /usr/local/bin/wasm-opt \
    && cmake --version \
    && ninja --version \
    && ccache --version \
    && mold --version \
    && node --version \
    && wasm-opt --version

WORKDIR /workspace

ARG MMLTK_IMAGE_FINGERPRINT=unlabeled
ARG MMLTK_GCC_IDENTITY=unknown
ARG MMLTK_UBUNTU_IDENTITY=unknown
LABEL com.mmltk.input-fingerprint="${MMLTK_IMAGE_FINGERPRINT}" \
      com.mmltk.gcc-identity="${MMLTK_GCC_IDENTITY}" \
      com.mmltk.ubuntu-identity="${MMLTK_UBUNTU_IDENTITY}"
