GCC 16 removed the evex512 target attribute. Keep the pinned Trunk dependency's
existing SIMD implementations and restrict that attribute to GCC 14 and 15.
Source: https://gcc.gnu.org/gcc-16/changes.html

--- a/libdeflate/lib/x86/cpu_features.h
+++ b/libdeflate/lib/x86/cpu_features.h
@@ -159,7 +159,7 @@
-#if (GCC_PREREQ(14, 0) || CLANG_PREREQ(18, 0, 18000000)) \
+#if ((GCC_PREREQ(14, 0) && !GCC_PREREQ(16, 0)) || CLANG_PREREQ(18, 0, 18000000)) \
 	&& !defined(__EVEX512__) /* avoid subtracting the evex512 feature */
 #  define EVEX512	",evex512"	/* needed to override potential -mno-evex512 */
 #  define NO_EVEX512	",no-evex512"	/* needed for AVX10/256 compatibility */
 #else
 #  define EVEX512	""
 #  define NO_EVEX512	""
