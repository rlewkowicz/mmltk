# syntax=docker/dockerfile:1

ARG MMLTK_NVIDIA_DONOR_IMAGE
FROM ${MMLTK_NVIDIA_DONOR_IMAGE} AS inventory
ARG MMLTK_NVIDIA_DONOR_IMAGE
ARG MMLTK_DIAGNOSTIC_HEADERS
ENV MMLTK_DIAGNOSTIC_IMAGE=${MMLTK_NVIDIA_DONOR_IMAGE} \
    PYTHONDONTWRITEBYTECODE=1
RUN --network=none --mount=type=bind,from=mmltk_tools,source=.,target=/opt/mmltk-tools \
    --mount=type=bind,source=docker,target=/diagnostic_metadata \
    /opt/mmltk-tools/mmltk --tool diagnose-nvidia-payload -- --header-list "${MMLTK_DIAGNOSTIC_HEADERS}" >/headers.json

FROM scratch
COPY --from=inventory /headers.json /
