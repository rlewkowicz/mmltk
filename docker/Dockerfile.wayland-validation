# syntax=docker/dockerfile:1

ARG WESTON_VERSION=13.0.0-4build3

FROM mmltk_build AS seat-builder
ARG WESTON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libweston-13-dev="${WESTON_VERSION}" pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY tools /tmp/native-tools/tools
COPY docker/nvidia-payload.json /tmp/native-tools/docker/nvidia-payload.json
RUN cmake -S /tmp/native-tools/tools -B /tmp/weston-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DMMLTK_TOOLS_BUILD_DRIVER=OFF \
        -DMMLTK_TOOLS_BUILD_WESTON_SEAT=ON \
    && cmake --build /tmp/weston-build --target mmltk_headless_weston_seat \
    && cmake --install /tmp/weston-build --prefix /tmp/weston-stage --component Runtime

FROM mmltk_runtime
ARG WESTON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        weston="${WESTON_VERSION}" libweston-13-0="${WESTON_VERSION}" wayland-utils gdb \
    && rm -rf /var/lib/apt/lists/*
COPY --from=seat-builder /tmp/weston-stage/lib/weston/mmltk-headless-seat.so /usr/lib/weston/mmltk-headless-seat.so

ARG MMLTK_IMAGE_FINGERPRINT=unlabeled
ARG MMLTK_RUNTIME_IDENTITY
ARG MMLTK_BUILD_IDENTITY
LABEL com.mmltk.input-fingerprint="${MMLTK_IMAGE_FINGERPRINT}" \
      com.mmltk.runtime-identity="${MMLTK_RUNTIME_IDENTITY}" \
      com.mmltk.build-identity="${MMLTK_BUILD_IDENTITY}"
