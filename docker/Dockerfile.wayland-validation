# syntax=docker/dockerfile:1

ARG WESTON_VERSION=13.0.0-4build3

FROM mmltk_build AS seat-builder
ARG WESTON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libweston-13-dev="${WESTON_VERSION}" pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY tools/headless_weston_seat.cpp /tmp/headless_weston_seat.cpp
RUN test "$(/opt/gcc-16.2/bin/g++ -dumpfullversion)" = 16.2.0 \
    && /opt/gcc-16.2/bin/g++ -std=c++26 -O2 -fPIC -shared \
        -Wall -Wextra -Werror -Wl,-z,defs \
        /tmp/headless_weston_seat.cpp -o /tmp/mmltk-headless-seat.so \
        $(pkg-config --cflags-only-I libweston-13 wayland-server | sed 's/-I/-isystem /g') \
        $(pkg-config --cflags-only-other --libs libweston-13 wayland-server)

FROM mmltk_runtime
ARG WESTON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        weston="${WESTON_VERSION}" libweston-13-0="${WESTON_VERSION}" wayland-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=seat-builder /tmp/mmltk-headless-seat.so /usr/lib/weston/mmltk-headless-seat.so

ARG MMLTK_IMAGE_FINGERPRINT=unlabeled
ARG MMLTK_RUNTIME_IDENTITY
ARG MMLTK_BUILD_IDENTITY
LABEL com.mmltk.input-fingerprint="${MMLTK_IMAGE_FINGERPRINT}" \
      com.mmltk.runtime-identity="${MMLTK_RUNTIME_IDENTITY}" \
      com.mmltk.build-identity="${MMLTK_BUILD_IDENTITY}"
