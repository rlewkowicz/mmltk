# syntax=docker/dockerfile:1

ARG MMLTK_RUNTIME_BASE_IMAGE=mmltk-runtime-base:latest
FROM ${MMLTK_RUNTIME_BASE_IMAGE}

ARG MMLTK_IMAGE_FINGERPRINT=unlabeled
ARG MMLTK_RELEASE_FINGERPRINT=unlabeled
ARG MMLTK_RUNTIME_BASE_IDENTITY=unknown

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The shared inventory admits and copies only production package roots. The
# source stage and helper are read-only build inputs and are not image layers.
RUN --mount=type=bind,source=.,target=/tmp/mmltk-release \
    --mount=type=bind,from=mmltk_package,source=runtime_package.sh,target=/tmp/runtime_package.sh \
    source /tmp/runtime_package.sh \
    && runtime_package_install /tmp/mmltk-release

RUN firefox_root=/opt/mmltk/lib/mmltk/firefox \
    && for firefox_object in firefox-bin libmozgtk.so libxul.so; do \
        LD_LIBRARY_PATH="${firefox_root}:${LD_LIBRARY_PATH}" \
            /lib64/ld-linux-x86-64.so.2 --list "${firefox_root}/${firefox_object}" || exit $?; \
    done

RUN python3 /usr/local/libexec/mmltk/verify_nvidia_payload.py --mode runtime --packaged

LABEL com.mmltk.input-fingerprint="${MMLTK_IMAGE_FINGERPRINT}" \
      com.mmltk.release-fingerprint="${MMLTK_RELEASE_FINGERPRINT}" \
      com.mmltk.runtime-base-identity="${MMLTK_RUNTIME_BASE_IDENTITY}"
