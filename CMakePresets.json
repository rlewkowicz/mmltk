{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "container-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/gcc-16.2/bin/gcc",
        "CMAKE_CXX_COMPILER": "/opt/gcc-16.2/bin/g++",
        "CMAKE_CUDA_HOST_COMPILER": "/opt/gcc-16.2/bin/g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MMLTK_CUDA_ARCHITECTURES": "86;87;89;90;100;103;110;120;121",
        "MMLTK_FIREFOX_CACHE_ROOT": "${sourceDir}/.cache/firefox",
        "MMLTK_ONNX_ROOT": "/opt/onnx",
        "MMLTK_TORCH_CUDA_ARCH_LIST": "8.6 8.7 8.9 9.0 10.0 10.3 11.0 12.0 12.1",
        "Protobuf_PROTOC_EXECUTABLE": "/usr/bin/protoc",
        "Python3_EXECUTABLE": "/usr/bin/python3"
      }
    },
    {
      "name": "release",
      "inherits": "container-base",
      "binaryDir": "${sourceDir}/.cache/cmake/release",
      "cacheVariables": {
        "BUILD_MMLTK_BROWSER_APP": "ON",
        "BUILD_MMLTK_BROWSER_HOST": "ON",
        "BUILD_MMLTK_FIREFOX_RUNTIME": "ON",
        "BUILD_RFDETR_NATIVE": "ON",
        "BUILD_RFDETR_PYTHON_CHECKPOINT_LOADER": "ON",
        "BUILD_TESTS": "ON",
        "CMAKE_INSTALL_PREFIX": "/opt/mmltk",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gui",
      "inherits": "container-base",
      "binaryDir": "${sourceDir}/.cache/cmake/gui",
      "cacheVariables": {
        "BUILD_MMLTK_BROWSER_APP": "ON",
        "BUILD_MMLTK_BROWSER_HOST": "OFF",
        "BUILD_MMLTK_FIREFOX_RUNTIME": "OFF",
        "BUILD_RFDETR_NATIVE": "ON",
        "BUILD_RFDETR_PYTHON_CHECKPOINT_LOADER": "OFF",
        "BUILD_TESTS": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "dev",
      "inherits": "container-base",
      "binaryDir": "${sourceDir}/.cache/cmake/dev",
      "cacheVariables": {
        "BUILD_MMLTK_BROWSER_APP": "ON",
        "BUILD_MMLTK_BROWSER_HOST": "OFF",
        "BUILD_MMLTK_FIREFOX_RUNTIME": "OFF",
        "BUILD_RFDETR_NATIVE": "ON",
        "BUILD_RFDETR_PYTHON_CHECKPOINT_LOADER": "ON",
        "BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Dev"
      }
    },
    {
      "name": "analysis",
      "inherits": "container-base",
      "binaryDir": "${sourceDir}/.cache/cmake/analysis",
      "cacheVariables": {
        "BUILD_MMLTK_BROWSER_APP": "ON",
        "BUILD_MMLTK_BROWSER_HOST": "OFF",
        "BUILD_MMLTK_FIREFOX_RUNTIME": "OFF",
        "BUILD_RFDETR_NATIVE": "ON",
        "BUILD_RFDETR_PYTHON_CHECKPOINT_LOADER": "ON",
        "BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Dev",
        "MMLTK_STATIC_ANALYSIS_BUILD": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "container-base",
      "binaryDir": "${sourceDir}/.cache/cmake/tsan",
      "cacheVariables": {
        "BUILD_MMLTK_BROWSER_APP": "ON",
        "BUILD_MMLTK_BROWSER_HOST": "OFF",
        "BUILD_MMLTK_FIREFOX_RUNTIME": "OFF",
        "BUILD_RFDETR_NATIVE": "ON",
        "BUILD_RFDETR_PYTHON_CHECKPOINT_LOADER": "ON",
        "BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Dev",
        "MMLTK_DEV_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "gui",
      "configurePreset": "gui",
      "targets": [
        "mmltk_frontend_iced_bundle"
      ]
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "analysis",
      "configurePreset": "analysis"
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
