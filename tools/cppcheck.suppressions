# Cppcheck 2.21 treats aggregate contract/schema records without default member
# initializers as uninitialized even though every instance is aggregate-initialized.
# Adding defaults would alter trivial-default-construction and mapped-file layout
# contracts. GCC's uninitialized warnings and clang's analyzer remain enabled.
uninitMemberVarNoCtor

# Compact ABI descriptors cross asynchronous boundaries by value. Cppcheck
# does not model those moves or ABI register passing. Clang's type-aware
# performance-unnecessary-value-param check remains enabled for every unit.
passedByValue
