dependencies_image_name="${MMLTK_DEPENDENCIES_IMAGE:-mmltk-dependencies:latest}"
image_producers_prepared=0
analysis_image_name="${MMLTK_ANALYSIS_IMAGE:-${image_name}-analysis}"
host_workdir="${PWD}"
requested_cache_root="${MMLTK_CACHE_ROOT:-${repo_root}/.cache}"
if [[ "${requested_cache_root}" != /* ]]; then
    requested_cache_root="${repo_root}/${requested_cache_root}"
fi
cache_root="$(realpath -m -- "${requested_cache_root}")"
repository_cache_root="${repo_root}/.cache"
buildkit_cache_root="${cache_root}/buildkit"
cmake_cache_root="${cache_root}/cmake"
cargo_cache_root="${cache_root}/cargo"
ccache_root="${cache_root}/ccache"
firefox_cache_root="${cache_root}/firefox"
firefox_build_input_file="${firefox_cache_root}/build-input.sha256"
image_fingerprint_root="${cache_root}/image-fingerprints"
lock_root="${cache_root}/locks"
requested_release_stage_root="${MMLTK_RELEASE_STAGE_ROOT:-${repo_root}/build/release}"
if [[ "${requested_release_stage_root}" != /* ]]; then
    requested_release_stage_root="${repo_root}/${requested_release_stage_root}"
fi
release_stage_root="$(realpath -m -- "${requested_release_stage_root}")"
gui_frontend_dist_dir="${cmake_cache_root}/gui/frontend/iced/dist"
release_frontend_dist_dir="${cmake_cache_root}/release/frontend/iced/dist"
uid="$(id -u)"
gid="$(id -g)"

gui_diagnostics_quiet=0
for wrapper_argument in "$@"; do
    if [[ "${wrapper_argument}" == "--gui" ]]; then gui_diagnostics_quiet=1; fi
done
wrapper_log_level="${MMLTK_LOG_LEVEL:-}"
if [[ -n "${MMLTK_GUI_TRACE_FILE:-}" || "${MMLTK_ANNOTATION_DIAGNOSTICS:-}" == "1" || "${MMLTK_RUN_WORKSPACE_WAYLAND_INTEGRATION:-}" == "1" ]] ||
    [[ "${wrapper_log_level,,}" != "off" && -n "${wrapper_log_level}${MMLTK_LOG_FILE:-}${MMLTK_LOG_DIR:-}" ]]; then
    gui_diagnostics_quiet=0
fi

log() {
    printf 'mmltk: %s\n' "$*" >&2
}

error() {
    printf 'mmltk: %s\n' "$*" >&2
}

die() {
    error "$*"
    exit 1
}

online_cpu_file="/sys/devices/system/cpu/online"
[[ -r "${online_cpu_file}" ]] || die "Linux online CPU list is unavailable"
build_cpu_list="$(<"${online_cpu_file}")"
[[ "${build_cpu_list}" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]] || die \
    "invalid Linux online CPU list: ${build_cpu_list}"
build_jobs="$(getconf _NPROCESSORS_ONLN)"
[[ "${build_jobs}" =~ ^[1-9][0-9]*$ ]] || die \
    "invalid online CPU count: ${build_jobs}"

case "${cache_root}" in
    "${repository_cache_root}"|"${repository_cache_root}/"*)
        ;;
    *)
        die "MMLTK_CACHE_ROOT must stay under ${repository_cache_root}"
        ;;
esac
case "${release_stage_root}" in
    "${repo_root}/build/"*)
        ;;
    *)
        die "MMLTK_RELEASE_STAGE_ROOT must stay under ${repo_root}/build"
        ;;
esac
container_cache_root="/workspace${cache_root#"${repo_root}"}"
container_release_stage_root="/workspace${release_stage_root#"${repo_root}"}"
container_firefox_sccache_basedirs="${container_cache_root}/firefox/obj-minimal-opt"
container_firefox_sccache_basedirs+=":/workspace/third_party/firefox"
container_firefox_sccache_basedirs+=":${container_cache_root}/firefox/mozbuild/sysroot-x86_64-linux-gnu"
build_trace_file="${MMLTK_BUILD_TRACE_FILE:-}"
ccache_stats_file="${MMLTK_CCACHE_STATS_FILE:-}"
firefox_sccache_stats_file="${MMLTK_FIREFOX_SCCACHE_STATS_FILE:-}"
container_ccache_stats_file=""
container_firefox_sccache_stats_file=""
container_build_trace_file=""
firefox_stage_trace_file=""
container_firefox_stage_trace_file=""
build_trace_enabled=0

prepare_trace_report_file() {
    local requested_path="$1"
    local variable_name="$2"
    if [[ "${requested_path}" != /* ]]; then
        requested_path="${host_workdir}/${requested_path}"
    fi
    requested_path="$(realpath -m -- "${requested_path}")"
    case "${requested_path}" in
        "${repo_root}/build/"*)
            ;;
        *)
            die "${variable_name} must stay under ${repo_root}/build"
            ;;
    esac
    prepare_owned_dirs "$(dirname "${requested_path}")"
    : >"${requested_path}"
    chown "${uid}:${gid}" "${requested_path}" 2>/dev/null || true
    printf '%s\n' "${requested_path}"
}

initialize_build_trace() {
    [[ -n "${build_trace_file}" ]] || return 0
    if [[ "${build_trace_file}" != /* ]]; then
        build_trace_file="${host_workdir}/${build_trace_file}"
    fi
    build_trace_file="$(realpath -m -- "${build_trace_file}")"
    case "${build_trace_file}" in
        "${repo_root}/"*)
            ;;
        *)
            die "MMLTK_BUILD_TRACE_FILE must stay under ${repo_root}"
            ;;
    esac
    prepare_owned_dirs "$(dirname "${build_trace_file}")"
    touch "${build_trace_file}"
    chown "${uid}:${gid}" "${build_trace_file}" 2>/dev/null || true
    container_build_trace_file="/workspace${build_trace_file#"${repo_root}"}"
    firefox_stage_trace_file="${build_trace_file%.jsonl}-firefox-stage.jsonl"
    : >"${firefox_stage_trace_file}"
    chown "${uid}:${gid}" "${firefox_stage_trace_file}" 2>/dev/null || true
    container_firefox_stage_trace_file="/workspace${firefox_stage_trace_file#"${repo_root}"}"
    if [[ -n "${ccache_stats_file}" ]]; then
        ccache_stats_file="$(prepare_trace_report_file \
            "${ccache_stats_file}" MMLTK_CCACHE_STATS_FILE)"
        container_ccache_stats_file="/workspace${ccache_stats_file#"${repo_root}"}"
    fi
    if [[ -n "${firefox_sccache_stats_file}" ]]; then
        firefox_sccache_stats_file="$(prepare_trace_report_file \
            "${firefox_sccache_stats_file}" MMLTK_FIREFOX_SCCACHE_STATS_FILE)"
        container_firefox_sccache_stats_file="/workspace${firefox_sccache_stats_file#"${repo_root}"}"
    fi
    build_trace_enabled=1
}

trace_build_event() {
    (( build_trace_enabled )) || return 0
    local phase="$1"
    local event="$2"
    local result="${3:-}"
    printf '{"timestamp_ns":%s,"pid":%d,"phase":"%s","event":"%s","result":"%s"}\n' \
        "$(date +%s%N)" "${BASHPID}" "${phase}" "${event}" "${result}" \
        >>"${build_trace_file}"
}

trace_build_job_assignment() {
    (( build_trace_enabled )) || return 0
    printf '{"timestamp_ns":%s,"pid":%d,"phase":"jobs","event":"assigned","cpus":"%s","ninja":%d,"cargo":%d,"firefox":%d}\n' \
        "$(date +%s%N)" "${BASHPID}" \
        "${build_cpu_list}" "${build_jobs}" "${build_jobs}" "${build_jobs}" \
        >>"${build_trace_file}"
}

run_traced_build_phase() (
    local phase="$1"
    shift
    trace_build_event "${phase}" start
    finish_traced_build_phase() {
        local exit_status=$?
        trap - EXIT
        if (( exit_status == 0 )); then
            trace_build_event "${phase}" finish success
        else
            trace_build_event "${phase}" finish "failure:${exit_status}"
        fi
        exit "${exit_status}"
    }
    trap finish_traced_build_phase EXIT
    "$@"
)

# When running as root, resolve the first real (login-capable) user on the box
# so the container uses that uid/gid for mounts and device access.
resolve_real_user() {
    if (( uid != 0 )); then
        return 0
    fi

    local target_user="${MMLTK_USER:-}"
    if [[ -z "${target_user}" ]]; then
        # First UID >= 1000 with a real login shell
        local entry
        while IFS=: read -r entry; do
            local u_name u_uid u_gid u_shell
            u_name="$(echo "${entry}" | cut -d: -f1)"
            u_uid="$(echo "${entry}" | cut -d: -f3)"
            u_gid="$(echo "${entry}" | cut -d: -f4)"
            u_shell="$(echo "${entry}" | cut -d: -f7)"
            if (( u_uid >= 1000 )) && [[ "${u_shell}" != */nologin && "${u_shell}" != */false ]]; then
                target_user="${u_name}"
                uid="${u_uid}"
                gid="${u_gid}"
                break
            fi
        done < /etc/passwd
    else
        uid="$(id -u "${target_user}")"
        gid="$(id -g "${target_user}")"
    fi

    if [[ -z "${target_user}" ]]; then
        error "warning: running as root, no real user found (set MMLTK_USER to override)"
        return 0
    fi
    if (( ! gui_diagnostics_quiet )); then log "running as root, resolved container user to ${target_user} (${uid}:${gid})"; fi
}
resolve_real_user

container_hash="$(printf '%s' "${repo_root}" | sha256sum | cut -c1-12)"
container_base_name="${MMLTK_CONTAINER_NAME:-mmltk-${container_hash}}"
container_name="${container_base_name}-${BASHPID}"
release_build_container_name="${container_base_name}-build-release"
package_build_container_name="${container_base_name}-build-package"
gui_build_container_name="${container_base_name}-build-gui"
test_build_container_name="${container_base_name}-test-build"
test_run_container_name="${container_base_name}-test-run"
tidy_container_name="${container_base_name}-tidy"
cleanup_report_container_name="${container_base_name}-cleanup-report"
buildx_builder_name="${MMLTK_BUILDX_BUILDER:-${container_base_name}-buildx}"
buildx_builder_ready=0
default_engine_builder_ready=0
container_cleanup_armed=0
mutation_locks_acquired=0
runtime_lock_acquired=0
runtime_lock_fd=-1
stale_container_cleanup_done=0
active_docker_pid=0
active_headless_compositor=0
shutdown_docker_pid=0
cleanup_docker_pid=0
shutdown_signal_count=0
active_build_pids=()
declare -A active_build_start_ticks=()
active_build_container_names=()
wrapper_pid="$$"
wrapper_start_ticks="$(awk '{ print $22 }' "/proc/${wrapper_pid}/stat")"
invocation_mode="initializing"

build_process_start_ticks() {
    local pid="$1" expected_parent="$2" state
    local -a fields=()
    [[ -r "/proc/${pid}/stat" ]] || return 1
    state="$(<"/proc/${pid}/stat")"
    read -r -a fields <<<"${state##*) }"
    [[ "${fields[1]:-}" == "${expected_parent}" ]] || return 1
    printf '%s\n' "${fields[19]}"
}

track_build_pid() {
    local pid="$1" owner_pid="${BASHPID}"
    active_build_pids+=("${pid}")
    active_build_start_ticks["${pid}"]="$(build_process_start_ticks "${pid}" "${owner_pid}" || true)"
}

stop_owned_build_process() {
    local pid="$1" expected_start="$2" expected_parent="$3" actual_start
    [[ -n "${expected_start}" ]] || return 0
    actual_start="$(build_process_start_ticks "${pid}" "${expected_parent}" || true)"
    [[ "${actual_start}" == "${expected_start}" ]] || return 0
    # Freeze this owned parent before enumerating its children. This reaches
    # foreground Docker clients under traced shells without waiting for Bash
    # to handle a signal after its foreground command eventually returns.
    kill -STOP "${pid}" >/dev/null 2>&1 || return 0
    local -a children=()
    if [[ -r "/proc/${pid}/task/${pid}/children" ]]; then
        read -r -a children <"/proc/${pid}/task/${pid}/children" || true
    fi
    local child child_start
    for child in "${children[@]}"; do
        child_start="$(build_process_start_ticks "${child}" "${pid}" || true)"
        stop_owned_build_process "${child}" "${child_start}" "${pid}"
    done
    actual_start="$(build_process_start_ticks "${pid}" "${expected_parent}" || true)"
    if [[ "${actual_start}" == "${expected_start}" ]]; then
        kill -KILL "${pid}" >/dev/null 2>&1 || true
    fi
}

terminate_active_builds() {
    local container
    for container in "${active_build_container_names[@]}"; do
        docker rm -f "${container}" >/dev/null 2>&1 || true
    done
    active_build_container_names=()

    local pid
    for pid in "${active_build_pids[@]}"; do
        stop_owned_build_process "${pid}" "${active_build_start_ticks[${pid}]:-}" "${BASHPID}"
    done
    for pid in "${active_build_pids[@]}"; do
        wait "${pid}" >/dev/null 2>&1 || true
    done
    active_build_pids=()
    active_build_start_ticks=()
}

run_owned_container_command() {
    local owned_container_name="$1"
    shift

    active_build_container_names=("${owned_container_name}")
    docker rm -f "${owned_container_name}" >/dev/null 2>&1 || true
    local exit_status=0
    if "$@"; then
        exit_status=0
    else
        exit_status=$?
    fi
    active_build_container_names=()
    return "${exit_status}"
}

run_owned_toolchain_command() {
    local owned_container_name="$1"
    local command="$2"
    run_owned_container_command "${owned_container_name}" \
        run_toolchain_command "${command}" "${owned_container_name}"
}

run_owned_docker_command() {
    local owned_container_name="$1"
    shift
    run_owned_container_command "${owned_container_name}" docker "$@"
}

wait_for_owned_subprocess() {
    local owned_pid="$1"
    local wait_status=0
    while true; do
        if wait "${owned_pid}"; then
            return 0
        fi
        wait_status=$?
        if ! kill -0 "${owned_pid}" >/dev/null 2>&1; then
            return "${wait_status}"
        fi
    done
}

kill_owned_local_process() {
    local owned_pid="$1"
    if (( owned_pid <= 0 )); then
        return 0
    fi
    local -a children=()
    if [[ -r "/proc/${owned_pid}/task/${owned_pid}/children" ]]; then
        read -r -a children < "/proc/${owned_pid}/task/${owned_pid}/children" || true
    fi
    local child_pid
    for child_pid in "${children[@]}"; do
        kill -KILL "${child_pid}" >/dev/null 2>&1 || true
    done
    kill -KILL "${owned_pid}" >/dev/null 2>&1 || true
}

remove_owned_container_bounded() {
    local timeout_seconds="$1"
    timeout --foreground --signal=KILL "${timeout_seconds}s" docker rm -f "${container_name}" >/dev/null 2>&1 &
    cleanup_docker_pid=$!
    local removal_status=0
    wait_for_owned_subprocess "${cleanup_docker_pid}" || removal_status=$?
    cleanup_docker_pid=0
    return "${removal_status}"
}

cleanup_owned_container() {
    local exit_status="$1"
    trap - EXIT
    trap 'force_shutdown_from_signal' HUP INT QUIT ABRT PIPE TERM USR1 USR2
    terminate_active_builds
    if (( container_cleanup_armed )); then
        container_cleanup_armed=0
        local cleanup_status=0
        remove_owned_container_bounded 15 || cleanup_status=$?
        if (( cleanup_status != 0 )); then
            cleanup_status=0
            remove_owned_container_bounded 5 || cleanup_status=$?
        fi

        local remaining_container=""
        if ! remaining_container="$(timeout --foreground --signal=KILL 5s docker container ls -a \
            --filter "name=^/${container_name}$" --format '{{.Names}}' 2>/dev/null)"; then
            cleanup_status=1
        elif [[ -n "${remaining_container}" ]]; then
            cleanup_status=1
        else
            cleanup_status=0
        fi
        if (( cleanup_status != 0 )); then
            error "container cleanup did not complete within its bounded deadline"
            if (( exit_status == 0 )); then
                exit_status=1
            fi
        fi
    fi
    exit "${exit_status}"
}

force_shutdown_from_signal() {
    shutdown_signal_count=$((shutdown_signal_count + 1))
    kill_owned_local_process "${active_docker_pid}"
    kill_owned_local_process "${shutdown_docker_pid}"
    kill_owned_local_process "${cleanup_docker_pid}"
    terminate_active_builds
}

milliseconds_duration() {
    printf '%s.%03ds' "$(( $1 / 1000 ))" "$(( $1 % 1000 ))"
}

shutdown_gui_runtime_in_container() {
    local signal_name="${1:-TERM}"
    local grace_ticks="${2:-100}"
    if [[ "${gui_mode:-0}" != "1" ]] || (( ! container_cleanup_armed )); then
        return 0
    fi

    timeout --foreground --signal=KILL 15s docker exec -u 0 "${container_name}" /bin/sh -lc "$(declare -f milliseconds_duration)"'
        signal_name="$1"
        grace_ticks="$2"
        runtime_pid="$(pgrep -o -f "[/]opt/mmltk/bin/mmltk-browser-host" 2>/dev/null || true)"
        if [ -z "${runtime_pid}" ]; then
            exit 0
        fi

        signal_runtime() {
            signal_name="$1"
            kill "-${signal_name}" "${runtime_pid}" 2>/dev/null || true
        }

        wait_runtime() {
            wait_ticks="$1"
            wait_milliseconds=$((wait_ticks * 100))
            if ! pgrep -f "[/]opt/mmltk/bin/mmltk-browser-host" >/dev/null 2>&1; then
                return 0
            fi
            if timeout --foreground --signal=KILL "$(milliseconds_duration "${wait_milliseconds}")" \
                    pidwait -o -f "[/]opt/mmltk/bin/mmltk-browser-host"; then
                return 0
            fi
            ! pgrep -f "[/]opt/mmltk/bin/mmltk-browser-host" >/dev/null 2>&1
        }

        signal_runtime "${signal_name}"
        if wait_runtime "${grace_ticks}"; then
            exit 0
        fi
        signal_runtime TERM
        if wait_runtime 10; then
            exit 0
        fi
        signal_runtime KILL
        wait_runtime 10 || true
        exit 1
    ' mmltk-gui-shutdown "${signal_name}" "${grace_ticks}" >/dev/null 2>&1 &
    shutdown_docker_pid=$!
    local shutdown_status=0
    wait_for_owned_subprocess "${shutdown_docker_pid}" || shutdown_status=$?
    shutdown_docker_pid=0
    return "${shutdown_status}"
}

wait_for_local_pid_exit() {
    local target_pid="$1"
    local timeout_ms="$2"
    if ! kill -0 "${target_pid}" >/dev/null 2>&1; then
        return 0
    fi
    if timeout --foreground --signal=KILL "$(milliseconds_duration "${timeout_ms}")" \
            pidwait -p "${target_pid}"; then
        return 0
    fi
    ! kill -0 "${target_pid}" >/dev/null 2>&1
}

terminate_active_docker_exec() {
    local signal_name="$1"
    if (( active_docker_pid <= 0 )); then
        return 0
    fi
    kill -s "${signal_name}" "${active_docker_pid}" >/dev/null 2>&1 || true
    if ! wait_for_local_pid_exit "${active_docker_pid}" 2000; then
        kill -TERM "${active_docker_pid}" >/dev/null 2>&1 || true
    fi
    if ! wait_for_local_pid_exit "${active_docker_pid}" 2000; then
        kill -KILL "${active_docker_pid}" >/dev/null 2>&1 || true
        wait_for_local_pid_exit "${active_docker_pid}" 1000 || true
    fi
    wait "${active_docker_pid}" >/dev/null 2>&1 || true
    active_docker_pid=0
}

exit_from_signal() {
    local signal_name="$1"
    local exit_status="$2"
    if (( shutdown_signal_count != 0 )); then
        force_shutdown_from_signal
        return
    fi
    shutdown_signal_count=1
    trap 'force_shutdown_from_signal' HUP INT QUIT ABRT PIPE TERM USR1 USR2
    local runtime_signal=TERM
    if [[ "${signal_name}" == "INT" ]]; then
        runtime_signal=INT
    fi
    if (( active_headless_compositor )); then
        # Give the session owner time to retire its children and flush artifacts
        # before the existing forced container cleanup handles any remainder.
        timeout --foreground --signal=KILL 25s \
            docker stop --time 22 "${test_run_container_name}" >/dev/null 2>&1 || true
    fi
    shutdown_gui_runtime_in_container "${runtime_signal}" 100 || true
    terminate_active_docker_exec "${signal_name}"
    terminate_active_builds
    exit "${exit_status}"
}

trap 'cleanup_owned_container "$?"' EXIT
trap 'exit_from_signal HUP 129' HUP
trap 'exit_from_signal INT 130' INT
trap 'exit_from_signal QUIT 131' QUIT
trap 'exit_from_signal ABRT 134' ABRT
trap 'exit_from_signal PIPE 141' PIPE
trap 'exit_from_signal TERM 143' TERM
trap 'exit_from_signal USR1 138' USR1
trap 'exit_from_signal USR2 140' USR2

docker_server_ready() {
    docker version --format '{{.Server.Version}}' >/dev/null 2>&1
}

best_effort_start_docker() {
    local -a attempts=(
        "systemctl --user start docker"
        "systemctl start docker"
        "service docker start"
        "sudo -n systemctl --user start docker"
        "sudo -n systemctl start docker"
        "sudo -n service docker start"
    )
    local attempt
    for attempt in "${attempts[@]}"; do
        if ${attempt} >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

ensure_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    if docker_server_ready; then
        cleanup_stale_wrapper_containers
        return 0
    fi

    if (( ! gui_diagnostics_quiet )); then log "docker daemon is unavailable; attempting a best-effort start"; fi
    best_effort_start_docker || true
    if docker_server_ready; then
        cleanup_stale_wrapper_containers
        return 0
    fi

    die "docker is still unavailable. Start dockerd, then rerun this command."
}

ensure_image() {
    docker image inspect "${image_name}" >/dev/null 2>&1 || die \
        "image '${image_name}' is missing. Build it first with: ./mmltk --build"
}

prepare_owned_dirs() {
    local path
    for path in "$@"; do
        install -d -m 0755 "${path}"
        chown "${uid}:${gid}" "${path}" 2>/dev/null || true
    done
}

prepare_cache_layout() {
    prepare_owned_dirs \
        "${cache_root}" \
        "${cmake_cache_root}/release" \
        "${cargo_cache_root}/home" \
        "${cargo_cache_root}/target/browser-app" \
        "${ccache_root}" \
        "${firefox_cache_root}/obj-minimal-opt" \
        "${firefox_cache_root}/mozbuild" \
        "${firefox_cache_root}/sccache" \
        "${buildkit_cache_root}" \
        "${image_fingerprint_root}" \
        "${lock_root}"
}

append_wrapper_labels() {
    local -n target_args="$1"
    local mode="$2"
    target_args+=(
        --label com.mmltk.wrapper=1
        --label "com.mmltk.repo=${repo_root}"
        --label "com.mmltk.owner-pid=${wrapper_pid}"
        --label "com.mmltk.owner-start=${wrapper_start_ticks}"
        --label "com.mmltk.mode=${mode}"
    )
}

prepare_lock_file() {
    local lock_file="$1"
    prepare_owned_dirs "$(dirname "${lock_file}")"
    touch "${lock_file}" || die "cannot create lock file '${lock_file}'"
    chown "${uid}:${gid}" "${lock_file}" 2>/dev/null || true
    chmod 0664 "${lock_file}" 2>/dev/null || true
    [[ -r "${lock_file}" && -w "${lock_file}" ]] || die \
        "lock file '${lock_file}' is not accessible to uid ${uid}"
}

acquire_mutation_locks() {
    (( mutation_locks_acquired == 0 )) || return 0
    command -v flock >/dev/null 2>&1 || die "flock is required"
    local checkout_lock="${repository_cache_root}/locks/checkout.lock"
    local cache_lock="${lock_root}/cache-root.lock"
    local runtime_lock="${repository_cache_root}/locks/runtime.lock"
    prepare_lock_file "${checkout_lock}"
    prepare_lock_file "${cache_lock}"
    prepare_lock_file "${runtime_lock}"
    exec 8>>"${checkout_lock}"
    flock -n -x 8 || die \
        "another build, GUI build, test, or tidy invocation is already active in this checkout"
    exec 9>>"${cache_lock}"
    flock -n -x 9 || die \
        "another invocation is already mutating cache root '${cache_root}'"
    mutation_locks_acquired=1
}

release_mutation_locks() {
    (( mutation_locks_acquired == 1 )) || return 0
    flock -u 9
    exec 9>&-
    flock -u 8
    exec 8>&-
    mutation_locks_acquired=0
}

acquire_runtime_lock() {
    (( runtime_lock_acquired == 0 )) || return 0
    command -v flock >/dev/null 2>&1 || die "flock is required"
    local runtime_lock="${repository_cache_root}/locks/runtime.lock"
    prepare_lock_file "${runtime_lock}"
    exec {runtime_lock_fd}>>"${runtime_lock}"
    if (( gui_mode )); then
        flock -n -x "${runtime_lock_fd}" || die \
            "GUI cannot start while another GUI or raw mmltk invocation is active"
    else
        flock -n -s "${runtime_lock_fd}" || die \
            "raw mmltk invocation cannot start while the GUI is active"
    fi
    runtime_lock_acquired=1
}

release_runtime_lock() {
    (( runtime_lock_acquired == 1 )) || return 0
    flock -u "${runtime_lock_fd}"
    exec {runtime_lock_fd}>&-
    runtime_lock_fd=-1
    runtime_lock_acquired=0
}

cleanup_stale_wrapper_containers() {
    (( stale_container_cleanup_done == 0 )) || return 0
    stale_container_cleanup_done=1

    local -a candidate_ids=()
    mapfile -t candidate_ids < <(
        docker ps -aq \
            --filter label=com.mmltk.wrapper=1 \
            --filter "label=com.mmltk.repo=${repo_root}" 2>/dev/null || true
    )

    local candidate_id owner_pid owner_start live_start
    for candidate_id in "${candidate_ids[@]}"; do
        [[ -n "${candidate_id}" ]] || continue
        owner_pid="$(docker inspect \
            --format '{{ index .Config.Labels "com.mmltk.owner-pid" }}' \
            "${candidate_id}" 2>/dev/null || true)"
        owner_start="$(docker inspect \
            --format '{{ index .Config.Labels "com.mmltk.owner-start" }}' \
            "${candidate_id}" 2>/dev/null || true)"
        live_start=""
        if [[ "${owner_pid}" =~ ^[1-9][0-9]*$ && -r "/proc/${owner_pid}/stat" ]]; then
            live_start="$(awk '{ print $22 }' "/proc/${owner_pid}/stat" 2>/dev/null || true)"
        fi
        if [[ -n "${live_start}" && "${live_start}" == "${owner_start}" ]]; then
            continue
        fi
        if (( ! gui_diagnostics_quiet )); then log "removing orphaned wrapper container ${candidate_id}"; fi
        docker rm -f "${candidate_id}" >/dev/null 2>&1 || true
    done
}

ensure_buildx_builder() {
    (( buildx_builder_ready == 0 )) || return 0
    docker buildx version >/dev/null 2>&1 || die "docker buildx is required"

    local inspect_output=""
    if ! inspect_output="$(docker buildx inspect "${buildx_builder_name}" 2>/dev/null)"; then
        if (( ! gui_diagnostics_quiet )); then log "creating checkout-scoped Buildx builder '${buildx_builder_name}'"; fi
        local create_output=""
        if ! create_output="$(docker buildx create \
            --name "${buildx_builder_name}" \
            --driver docker-container 2>&1)"; then
            inspect_output="$(docker buildx inspect "${buildx_builder_name}" 2>/dev/null)" || die \
                "failed to create Buildx builder '${buildx_builder_name}': ${create_output}"
        fi
    fi

    inspect_output="$(docker buildx inspect "${buildx_builder_name}")"
    local builder_driver
    builder_driver="$(awk '/^Driver:/ { print $2; exit }' <<<"${inspect_output}")"
    [[ "${builder_driver}" == "docker-container" ]] || die \
        "Buildx builder '${buildx_builder_name}' uses '${builder_driver:-unknown}', expected docker-container"
    docker buildx inspect "${buildx_builder_name}" --bootstrap >/dev/null || die \
        "failed to bootstrap Buildx builder '${buildx_builder_name}'"
    buildx_builder_ready=1
}

ensure_default_engine_builder() {
    (( default_engine_builder_ready == 0 )) || return 0
    docker buildx version >/dev/null 2>&1 || die "docker buildx is required"

    local inspect_output=""
    if ! inspect_output="$(docker buildx inspect default 2>&1)"; then
        die "failed to inspect Buildx builder 'default': ${inspect_output}"
    fi
    local builder_driver
    builder_driver="$(awk '/^Driver:/ { print $2; exit }' <<<"${inspect_output}")"
    [[ "${builder_driver}" == "docker" ]] || die \
        "Buildx builder 'default' uses '${builder_driver:-unknown}', expected docker for Docker Engine image contexts"
    default_engine_builder_ready=1
}

content_derived_local_image_alias() {
    local component="$1"
    local image_identity="$2"
    [[ "${image_identity}" =~ ^sha256:[[:xdigit:]]{64}$ ]] || die \
        "image identity for '${component}' is not a Docker image ID: '${image_identity}'"

    local image_alias="mmltk-local-${component}:${image_identity#sha256:}"
    docker tag "${image_identity}" "${image_alias}"
    local alias_identity
    alias_identity="$(docker image inspect "${image_alias}" --format '{{.Id}}')"
    [[ "${alias_identity}" == "${image_identity}" ]] || die \
        "local alias '${image_alias}' resolves to '${alias_identity:-missing}', expected '${image_identity}'"
    printf '%s\n' "${image_alias}"
}

verify_content_derived_local_image_alias() {
    local image_alias="$1"
    local image_identity="$2"
    local alias_identity
    alias_identity="$(docker image inspect "${image_alias}" --format '{{.Id}}' 2>/dev/null || true)"
    [[ "${alias_identity}" == "${image_identity}" ]] || die \
        "local alias '${image_alias}' changed to '${alias_identity:-missing}', expected '${image_identity}'"
}

cached_buildx_image() {
    local builder="$1"
    local target="$2"
    local tag="$3"
    local dockerfile="$4"
    local cache_name="$5"
    local fingerprint="$6"
    local context="$7"
    shift 7
    local trace_event="image:${cache_name}"
    if [[ "${cache_name}" == runtime ]]; then trace_event=runtime_image; fi

    local fingerprint_dir="${image_fingerprint_root}"
    local fingerprint_file="${fingerprint_dir}/${cache_name}.sha256"
    local image_fingerprint=""
    if docker image inspect "${tag}" >/dev/null 2>&1; then
        image_fingerprint="$(docker image inspect "${tag}" \
            --format '{{ index .Config.Labels "com.mmltk.input-fingerprint" }}' 2>/dev/null || true)"
    fi
    if docker image inspect "${tag}" >/dev/null 2>&1 \
        && [[ "${image_fingerprint}" == "${fingerprint}" ]]; then
        prepare_owned_dirs "${fingerprint_dir}"
        if [[ ! -f "${fingerprint_file}" ]] \
            || [[ "$(<"${fingerprint_file}")" != "${fingerprint}" ]]; then
            printf '%s\n' "${fingerprint}" >"${fingerprint_file}"
        fi
        if [[ "${cache_name}" == runtime ]] && (( ! gui_diagnostics_quiet )); then log "runtime image is current"; fi
        trace_build_event "${trace_event}" cache_hit
        return 0
    fi
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    local build_cache="${buildkit_cache_root}/${cache_name}"
    local -a cache_args=()
    if [[ "${builder}" == "default" ]]; then
        ensure_default_engine_builder
        # The Docker driver owns its image-layer cache.  It cannot export the
        # local cache backend used by the isolated bootstrap builder.
        prepare_owned_dirs "${fingerprint_dir}"
    else
        ensure_buildx_builder
        [[ "${builder}" == "${buildx_builder_name}" ]] || die \
            "unsupported cached Buildx builder '${builder}'"
        prepare_owned_dirs "${fingerprint_dir}" "${build_cache}"
        cache_args=(--cache-to "type=local,dest=${build_cache},mode=max")
        if [[ -f "${build_cache}/index.json" ]]; then
            cache_args+=(--cache-from "type=local,src=${build_cache}")
        fi
    fi

    local -a target_args=()
    if [[ "${target}" != "-" ]]; then
        target_args+=(--target "${target}")
        if (( ! gui_diagnostics_quiet )); then log "building cached image '${tag}' from target '${target}'"; fi
    else
        if (( ! gui_diagnostics_quiet )); then log "building cached image '${tag}'"; fi
    fi
    trace_build_event "${trace_event}" cache_miss
    local build_status=0
    if docker buildx build \
            --builder "${builder}" \
            --progress=plain \
            --load \
            "${target_args[@]}" \
            --tag "${tag}" \
            --file "${dockerfile}" \
            --build-arg "MMLTK_IMAGE_FINGERPRINT=${fingerprint}" \
            "${cache_args[@]}" \
            "$@" \
            "${context}"; then
        :
    else
        build_status=$?
        error "failed to build cached image '${tag}' (exit ${build_status})"
        return "${build_status}"
    fi
    docker image inspect "${tag}" >/dev/null 2>&1 || die "image '${tag}' was not loaded"
    image_fingerprint="$(docker image inspect "${tag}" \
        --format '{{ index .Config.Labels "com.mmltk.input-fingerprint" }}')"
    [[ "${image_fingerprint}" == "${fingerprint}" ]] || die \
        "image '${tag}' has fingerprint label '${image_fingerprint:-missing}', expected '${fingerprint}'"
    printf '%s\n' "${fingerprint}" >"${fingerprint_file}"
}

manifest_value() {
    local key="$1"
    local value
    value="$(sed -n "s/.*\"${key}\": \"\([^\"]*\)\".*/\1/p" \
        "${repo_root}/docker/nvidia-payload.json")"
    [[ -n "${value}" && "${value}" != *$'\n'* ]] || die "manifest key '${key}' is missing or ambiguous"
    printf '%s\n' "${value}"
}

initialize_nvidia_inputs() {
    local canonical_donor
    canonical_donor="$(manifest_value donor)"
    nvidia_donor_image="${MMLTK_NVIDIA_DONOR_IMAGE:-${canonical_donor}}"
    [[ "${nvidia_donor_image}" == "${canonical_donor}" && "${nvidia_donor_image}" =~ @sha256:[[:xdigit:]]{64}$ ]] || die \
        "MMLTK_NVIDIA_DONOR_IMAGE must match the canonical immutable donor in docker/nvidia-payload.json"
    [[ "$(manifest_value platform)" == linux/amd64 ]] || die "NVIDIA payload requires Linux/amd64"
    nvidia_configuration_args=(
        --build-arg "MMLTK_CUDA_ROOT=$(manifest_value cuda_root)"
        --build-arg "MMLTK_PYTHON_ROOT=$(manifest_value python_root)"
        --build-arg "MMLTK_NVIDIA_LIBRARY_PATH=$(nvidia_library_path)"
        --build-arg "MMLTK_CUDA_VERSION=$(manifest_value cuda)"
        --build-arg "MMLTK_TORCH_VERSION=$(manifest_value torch)"
        --build-arg "MMLTK_TENSORRT_VERSION=$(manifest_value tensorrt)"
    )
}

nvidia_library_path() {
    local order key root result=""
    local -a root_keys=()
    order="$(sed -n 's/.*"library_order": \[\(.*\)\].*/\1/p' "${repo_root}/docker/nvidia-payload.json")"
    [[ -n "${order}" && "${order}" != *$'\n'* ]] || die "missing or ambiguous NVIDIA library order"
    order="${order//\"/}"
    order="${order//,/ }"
    read -r -a root_keys <<<"${order}"
    for key in "${root_keys[@]}"; do
        root="$(manifest_value "${key}")"
        if [[ "${key}" == cuda_root ]]; then root+=/lib64; else root+=/lib; fi
        result+="${result:+:}${root}"
    done
    printf '%s\n' "${result}"
}

verify_image_label() {
    local image="$1" key="$2" expected="$3"
    local actual
    actual="$(docker image inspect "${image}" --format "{{ index .Config.Labels \"com.mmltk.${key}\" }}")"
    [[ "${actual}" == "${expected}" ]] || die \
        "image '${image}' label '${key}' is '${actual:-missing}', expected '${expected}'"
}

verify_nvidia_image_labels() {
    local image="$1" mode="$2"
    verify_image_label "${image}" nvidia-donor "${nvidia_donor_image}"
    verify_image_label "${image}" payload-mode "${mode}"
    local component
    for component in cuda torch tensorrt; do
        verify_image_label "${image}" "${component}-version" "$(manifest_value "${component}")"
    done
}

owned_ubuntu_identity() {
    if ! docker image inspect ubuntu:24.04 >/dev/null 2>&1; then
        docker pull --platform linux/amd64 ubuntu:24.04 >&2
    fi
    [[ "$(docker image inspect ubuntu:24.04 --format '{{.Os}}/{{.Architecture}}')" == linux/amd64 ]] || die \
        "owned Ubuntu base requires Linux/amd64"
    docker image inspect ubuntu:24.04 --format '{{.Id}}'
}

nvidia_payload_image_fingerprint() {
    {
        printf '%s\n' nvidia-payload "${nvidia_donor_image}"
        sha256sum "${repo_root}/docker/Dockerfile.nvidia" \
            "${repo_root}/docker/nvidia-payload.json" \
            "${repo_root}/docker/materialize_nvidia_payload.py" \
            "${repo_root}/docker/nvidia_payload.py"
    } | sha256sum | cut -d' ' -f1
}

ensure_nvidia_payload_image() {
    initialize_nvidia_inputs
    local fingerprint
    fingerprint="$(nvidia_payload_image_fingerprint)"
    cached_buildx_image "${buildx_builder_name}" payload "${nvidia_payload_image_name}" \
        "${repo_root}/docker/Dockerfile.nvidia" nvidia-payload "${fingerprint}" "${repo_root}" \
        --platform "$(manifest_value platform)" --build-arg "MMLTK_NVIDIA_DONOR_IMAGE=${nvidia_donor_image}"
    verify_image_label "${nvidia_payload_image_name}" nvidia-donor "${nvidia_donor_image}"
    verify_image_label "${nvidia_payload_image_name}" payload-mode extraction
}

gcc16_image_fingerprint() {
    {
        printf '%s\n' gcc16 ubuntu:24.04
        sha256sum "${repo_root}/docker/Dockerfile.gcc"
    } | sha256sum | cut -d' ' -f1
}

ensure_gcc16_image() {
    local fingerprint
    fingerprint="$(gcc16_image_fingerprint)"
    cached_buildx_image "${buildx_builder_name}" gcc16 "${gcc16_image_name}" \
        "${repo_root}/docker/Dockerfile.gcc" gcc16 "${fingerprint}" "${repo_root}" \
        --build-arg "MMLTK_GCC_BUILD_IMAGE=ubuntu:24.04"
}

ensure_ubuntu_image() {
    local identity alias fingerprint
    identity="$(owned_ubuntu_identity)"
    alias="$(content_derived_local_image_alias ubuntu-source "${identity}")"
    fingerprint="$({
        printf '%s\n' ubuntu "${identity}"
        sha256sum "${repo_root}/docker/Dockerfile.ubuntu"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default ubuntu "${ubuntu_image_name}" \
        "${repo_root}/docker/Dockerfile.ubuntu" ubuntu "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_ubuntu=docker-image://${alias}" \
        --build-arg "MMLTK_UBUNTU_IDENTITY=${identity}"
    verify_content_derived_local_image_alias "${alias}" "${identity}"
    verify_image_label "${ubuntu_image_name}" ubuntu-identity "${identity}"
    verify_image_label "${ubuntu_image_name}" ubuntu-source-identity "${identity}"
}

verify_onnxruntime_image_labels() {
    verify_image_label "${onnxruntime_image_name}" ubuntu-identity \
        "$(docker image inspect "${ubuntu_image_name}" --format '{{.Id}}')"
    verify_image_label "${onnxruntime_image_name}" gcc-identity \
        "$(docker image inspect "${gcc16_image_name}" --format '{{.Id}}')"
    verify_image_label "${onnxruntime_image_name}" nvidia-payload-identity \
        "$(docker image inspect "${nvidia_payload_image_name}" --format '{{.Id}}')"
}

ensure_onnxruntime_image() {
    local ubuntu_identity gcc16_identity payload_identity ubuntu_alias gcc16_alias payload_alias fingerprint
    local onnxruntime_build_jobs="${build_jobs}"
    if (( onnxruntime_build_jobs > 12 )); then onnxruntime_build_jobs=12; fi
    ubuntu_identity="$(docker image inspect "${ubuntu_image_name}" --format '{{.Id}}')"
    gcc16_identity="$(docker image inspect "${gcc16_image_name}" --format '{{.Id}}')"
    payload_identity="$(docker image inspect "${nvidia_payload_image_name}" --format '{{.Id}}')"
    verify_image_label "${nvidia_payload_image_name}" nvidia-donor "${nvidia_donor_image}"
    verify_image_label "${nvidia_payload_image_name}" payload-mode extraction
    ubuntu_alias="$(content_derived_local_image_alias ubuntu "${ubuntu_identity}")"
    gcc16_alias="$(content_derived_local_image_alias gcc16 "${gcc16_identity}")"
    payload_alias="$(content_derived_local_image_alias nvidia-payload "${payload_identity}")"
    fingerprint="$({
        printf '%s\n' onnxruntime "${ubuntu_identity}" "${gcc16_identity}" "${payload_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.onnxruntime" \
            "${repo_root}/docker/patches/onnxruntime-1.27.1-cuda-graph-capture.patch" \
            "${repo_root}/docker/patches/onnxruntime-1.27.1-gcc16.patch"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default onnxruntime "${onnxruntime_image_name}" \
        "${repo_root}/docker/Dockerfile.onnxruntime" onnxruntime "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_ubuntu=docker-image://${ubuntu_alias}" \
        --build-context "mmltk_gcc16=docker-image://${gcc16_alias}" \
        --build-context "mmltk_nvidia_payload=docker-image://${payload_alias}" \
        --build-arg "MMLTK_UBUNTU_IDENTITY=${ubuntu_identity}" \
        --build-arg "MMLTK_GCC_IDENTITY=${gcc16_identity}" \
        --build-arg "MMLTK_NVIDIA_PAYLOAD_IDENTITY=${payload_identity}" \
        --build-arg "MMLTK_ONNXRUNTIME_BUILD_JOBS=${onnxruntime_build_jobs}" \
        --build-arg "MMLTK_NVIDIA_NATIVE_ROOT=$(manifest_value native_root)" \
        "${nvidia_configuration_args[@]}"
    verify_content_derived_local_image_alias "${ubuntu_alias}" "${ubuntu_identity}"
    verify_content_derived_local_image_alias "${gcc16_alias}" "${gcc16_identity}"
    verify_content_derived_local_image_alias "${payload_alias}" "${payload_identity}"
    verify_onnxruntime_image_labels
}

ensure_toolchain_base_image() {
    local gcc16_identity ubuntu_identity gcc16_alias ubuntu_alias fingerprint
    gcc16_identity="$(docker image inspect "${gcc16_image_name}" --format '{{.Id}}')"
    ubuntu_identity="$(docker image inspect "${ubuntu_image_name}" --format '{{.Id}}')"
    gcc16_alias="$(content_derived_local_image_alias gcc16 "${gcc16_identity}")"
    ubuntu_alias="$(content_derived_local_image_alias ubuntu "${ubuntu_identity}")"
    fingerprint="$({
        printf '%s\n' toolchain-base "${gcc16_identity}" "${ubuntu_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.core" \
            "${repo_root}/docker/patches/libdeflate-gcc16.patch" \
            "${repo_root}/docker/install_trunk.py" \
            "${repo_root}/docker/record_compiler_evidence.py" \
            "${repo_root}/src/frontend/iced/wasm-opt-wrapper"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default toolchain "${toolchain_base_image_name}" \
        "${repo_root}/docker/Dockerfile.core" core-toolchain "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_gcc16=docker-image://${gcc16_alias}" \
        --build-context "mmltk_ubuntu=docker-image://${ubuntu_alias}" \
        --build-arg "MMLTK_GCC_IDENTITY=${gcc16_identity}" \
        --build-arg "MMLTK_UBUNTU_IDENTITY=${ubuntu_identity}"
    verify_content_derived_local_image_alias "${gcc16_alias}" "${gcc16_identity}"
    verify_content_derived_local_image_alias "${ubuntu_alias}" "${ubuntu_identity}"
    verify_image_label "${toolchain_base_image_name}" gcc-identity "${gcc16_identity}"
    verify_image_label "${toolchain_base_image_name}" ubuntu-identity "${ubuntu_identity}"
}

ensure_dependencies_image() {
    local identity alias fingerprint
    identity="$(docker image inspect "${toolchain_base_image_name}" --format '{{.Id}}')"
    alias="$(content_derived_local_image_alias toolchain-base "${identity}")"
    fingerprint="$({
        printf '%s\n' dependencies "${identity}"
        sha256sum "${repo_root}/docker/Dockerfile.dependencies"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default dependencies "${dependencies_image_name}" \
        "${repo_root}/docker/Dockerfile.dependencies" dependencies "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_toolchain_base=docker-image://${alias}" \
        --build-arg "MMLTK_TOOLCHAIN_BASE_IDENTITY=${identity}"
    verify_content_derived_local_image_alias "${alias}" "${identity}"
    verify_image_label "${dependencies_image_name}" toolchain-base-identity "${identity}"
}

prepare_host_dependency_images() {
    ensure_toolchain_base_image
    ensure_dependencies_image
}

prepare_image_producers() {
    initialize_nvidia_inputs
    ensure_buildx_builder
    ensure_default_engine_builder
    ensure_ubuntu_image
    # Run this before the release/runtime branches so wait ownership stays local
    # and each producer publishes one completed image for both consumers.
    run_traced_build_phase nvidia_payload ensure_nvidia_payload_image &
    track_build_pid "$!"
    run_traced_build_phase gcc16 ensure_gcc16_image &
    track_build_pid "$!"
    wait_for_parallel_builds
    # ONNX source compilation consumes GCC and CUDA directly; it never consumes
    # the toolchain image that will later install its completed package.
    run_traced_build_phase host_dependencies prepare_host_dependency_images &
    track_build_pid "$!"
    run_traced_build_phase onnxruntime ensure_onnxruntime_image &
    track_build_pid "$!"
    wait_for_parallel_builds
}

ensure_build_image() {
    initialize_nvidia_inputs
    if (( image_producers_prepared == 0 )); then
        prepare_image_producers
        image_producers_prepared=1
    fi
    local base_identity payload_identity dependencies_identity ort_identity
    local dependencies_alias payload_alias ort_alias fingerprint compilation_identity
    base_identity="$(docker image inspect "${toolchain_base_image_name}" --format '{{.Id}}')"
    payload_identity="$(docker image inspect "${nvidia_payload_image_name}" --format '{{.Id}}')"
    dependencies_identity="$(docker image inspect "${dependencies_image_name}" --format '{{.Id}}')"
    ort_identity="$(docker image inspect "${onnxruntime_image_name}" --format '{{.Id}}')"
    verify_image_label "${dependencies_image_name}" toolchain-base-identity "${base_identity}"
    verify_image_label "${nvidia_payload_image_name}" nvidia-donor "${nvidia_donor_image}"
    verify_image_label "${nvidia_payload_image_name}" payload-mode extraction
    verify_onnxruntime_image_labels
    dependencies_alias="$(content_derived_local_image_alias dependencies "${dependencies_identity}")"
    payload_alias="$(content_derived_local_image_alias nvidia-payload "${payload_identity}")"
    ort_alias="$(content_derived_local_image_alias onnxruntime "${ort_identity}")"
    compilation_identity="sha256:$({
        printf '%s\n' compilation "${dependencies_identity}" "${payload_identity}" "${ort_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.toolchain" \
            "${repo_root}/docker/patches/gcc16-nvcc-string-substr.patch"
    } | sha256sum | cut -d' ' -f1)"
    fingerprint="$({
        printf '%s\n' toolchain "${base_identity}" "${dependencies_identity}" "${payload_identity}" "${ort_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.toolchain" \
            "${repo_root}/docker/patches/gcc16-nvcc-string-substr.patch" \
            "${repo_root}/docker/verify_nvidia_payload.py" "${repo_root}/docker/nvidia_payload.py" \
            "${repo_root}/tools/check_toolchain_invariants.py"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default - "${build_image_name}" \
        "${repo_root}/docker/Dockerfile.toolchain" toolchain "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_dependencies=docker-image://${dependencies_alias}" \
        --build-context "mmltk_nvidia_payload=docker-image://${payload_alias}" \
        --build-context "mmltk_onnxruntime=docker-image://${ort_alias}" \
        --build-arg "MMLTK_COMPILATION_IDENTITY=${compilation_identity}" \
        --build-arg "MMLTK_TOOLCHAIN_BASE_IDENTITY=${base_identity}" \
        --build-arg "MMLTK_DEPENDENCIES_IDENTITY=${dependencies_identity}" \
        --build-arg "MMLTK_ONNXRUNTIME_IDENTITY=${ort_identity}" \
        --build-arg "MMLTK_NVIDIA_PAYLOAD_IDENTITY=${payload_identity}" \
        --build-arg "MMLTK_NVIDIA_DONOR_IMAGE=${nvidia_donor_image}" \
        "${nvidia_configuration_args[@]}"
    verify_content_derived_local_image_alias "${dependencies_alias}" "${dependencies_identity}"
    verify_content_derived_local_image_alias "${payload_alias}" "${payload_identity}"
    verify_content_derived_local_image_alias "${ort_alias}" "${ort_identity}"
    verify_image_label "${build_image_name}" toolchain-base-identity "${base_identity}"
    verify_image_label "${build_image_name}" compilation-identity "${compilation_identity}"
    verify_image_label "${build_image_name}" dependencies-identity "${dependencies_identity}"
    verify_image_label "${build_image_name}" onnxruntime-identity "${ort_identity}"
    verify_image_label "${build_image_name}" nvidia-payload-identity "${payload_identity}"
    verify_nvidia_image_labels "${build_image_name}" development
}

ensure_runtime_base_image() {
    initialize_nvidia_inputs
    if (( image_producers_prepared == 0 )); then
        ensure_ubuntu_image
        ensure_gcc16_image
        ensure_nvidia_payload_image
        ensure_onnxruntime_image
    fi
    local payload_identity ubuntu_identity ort_identity payload_alias ubuntu_alias ort_alias fingerprint
    payload_identity="$(docker image inspect "${nvidia_payload_image_name}" --format '{{.Id}}')"
    ubuntu_identity="$(docker image inspect "${ubuntu_image_name}" --format '{{.Id}}')"
    ort_identity="$(docker image inspect "${onnxruntime_image_name}" --format '{{.Id}}')"
    verify_image_label "${nvidia_payload_image_name}" nvidia-donor "${nvidia_donor_image}"
    verify_image_label "${nvidia_payload_image_name}" payload-mode extraction
    verify_onnxruntime_image_labels
    payload_alias="$(content_derived_local_image_alias nvidia-payload "${payload_identity}")"
    ubuntu_alias="$(content_derived_local_image_alias ubuntu "${ubuntu_identity}")"
    ort_alias="$(content_derived_local_image_alias onnxruntime "${ort_identity}")"
    fingerprint="$({
        printf '%s\n' runtime-base "${payload_identity}" "${ubuntu_identity}" "${ort_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.runtime-base" \
            "${repo_root}/docker/verify_nvidia_payload.py" "${repo_root}/docker/nvidia_payload.py"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default runtime-base "${runtime_base_image_name}" \
        "${repo_root}/docker/Dockerfile.runtime-base" runtime-base "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_nvidia_payload=docker-image://${payload_alias}" \
        --build-context "mmltk_ubuntu=docker-image://${ubuntu_alias}" \
        --build-context "mmltk_onnxruntime=docker-image://${ort_alias}" \
        --build-arg "MMLTK_NVIDIA_DONOR_IMAGE=${nvidia_donor_image}" \
        --build-arg "MMLTK_NVIDIA_PAYLOAD_IDENTITY=${payload_identity}" \
        --build-arg "MMLTK_UBUNTU_IDENTITY=${ubuntu_identity}" \
        --build-arg "MMLTK_ONNXRUNTIME_IDENTITY=${ort_identity}" \
        "${nvidia_configuration_args[@]}"
    verify_content_derived_local_image_alias "${payload_alias}" "${payload_identity}"
    verify_content_derived_local_image_alias "${ubuntu_alias}" "${ubuntu_identity}"
    verify_content_derived_local_image_alias "${ort_alias}" "${ort_identity}"
    verify_image_label "${runtime_base_image_name}" nvidia-payload-identity "${payload_identity}"
    verify_image_label "${runtime_base_image_name}" onnxruntime-identity "${ort_identity}"
    verify_image_label "${runtime_base_image_name}" ubuntu-identity "${ubuntu_identity}"
    verify_nvidia_image_labels "${runtime_base_image_name}" runtime
}

ensure_analysis_image() {
    ensure_build_image
    local build_image_id analysis_image_id=""
    build_image_id="$(docker image inspect "${build_image_name}" --format '{{.Id}}')"
    if docker image inspect "${analysis_image_name}" >/dev/null 2>&1; then
        analysis_image_id="$(docker image inspect "${analysis_image_name}" --format '{{.Id}}')"
    fi
    if [[ "${analysis_image_id}" != "${build_image_id}" ]]; then
        if (( ! gui_diagnostics_quiet )); then log "tagging source-free toolchain as analysis image '${analysis_image_name}'"; fi
        docker tag "${build_image_name}" "${analysis_image_name}"
    fi
}

prepare_tidy_logging() {
    local tidy_log_file="${MMLTK_TIDY_LOG_FILE:-}"
    if [[ -z "${tidy_log_file}" ]]; then
        tidy_log_file="${repo_root}/build/logs/mmltk-tidy-$(date +%Y%m%d-%H%M%S).log"
    elif [[ "${tidy_log_file}" != /* ]]; then
        tidy_log_file="${host_workdir}/${tidy_log_file}"
    fi

    mkdir -p "$(dirname "${tidy_log_file}")"
    touch "${tidy_log_file}"
    chown "${uid}:${gid}" "$(dirname "${tidy_log_file}")" "${tidy_log_file}" 2>/dev/null || true
    export MMLTK_TIDY_LOG_FILE="${tidy_log_file}"
    export MMLTK_TIDY_TEE_STARTED=1
    exec > >(tee -a "${tidy_log_file}") 2>&1
    if (( ! gui_diagnostics_quiet )); then log "writing tidy log to ${tidy_log_file}"; fi
    if (( ! gui_diagnostics_quiet )); then log "tail with: tail -f ${tidy_log_file}"; fi
}

container_exists() {
    docker container inspect "${container_name}" >/dev/null 2>&1
}

container_running() {
    [[ "$(docker inspect --format '{{.State.Running}}' "${container_name}" 2>/dev/null || true)" == "true" ]]
}

image_id() {
    docker image inspect --format '{{.Id}}' "${image_name}"
}

container_runtime_label() {
    docker inspect --format '{{ index .Config.Labels "com.mmltk.runtime" }}' "${container_name}" 2>/dev/null || true
}

bind_mount_specs=()
desired_runtime_label=""
gui_platform=""
gui_runtime_dir_container="/tmp/mmltk-gui-runtime"
gui_wayland_socket_host_path=""
gui_wayland_socket_container_path=""
gui_dbus_socket_host_path=""
gui_dbus_socket_container_path=""

gui_runtime_tmpfs_spec() {
    printf '%s' "${gui_runtime_dir_container}:rw,mode=700,uid=${uid},gid=${gid}"
}

path_is_covered_by_bind_mount() {
    local source_path="$1"
    local existing_spec
    local existing_source
    for existing_spec in "${bind_mount_specs[@]}"; do
        existing_source="${existing_spec%%:*}"
        if [[ "${source_path}" == "${existing_source}" || "${source_path}" == "${existing_source}"/* ]]; then
            return 0
        fi
    done
    return 1
}

append_bind_mount() {
    local source_path="$1"
    local target_path="${2:-$1}"
    local mode="${3:-rw}"
    [[ -e "${source_path}" ]] || return 0
    path_is_covered_by_bind_mount "${source_path}" && return 0
    bind_mount_specs+=("${source_path}:${target_path}:${mode}")
}

extract_dbus_session_bus_path() {
    local address="$1"
    if [[ "${address}" =~ ^unix:path=([^,]+) ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
    fi
}

default_xdg_runtime_dir() {
    local candidate="/run/user/${uid}"
    [[ -d "${candidate}" ]] || return 1
    printf '%s' "${candidate}"
}

env_value_from_text() {
    local text="$1"
    local name="$2"
    printf '%s\n' "${text}" | sed -n "s/^${name}=//p" | head -n 1
}

infer_gui_environment_from_target_processes() {
    local proc_env proc_dir owner env_text value
    for proc_env in /proc/[0-9]*/environ; do
        proc_dir="${proc_env%/environ}"
        [[ -r "${proc_env}" ]] || continue
        owner="$(stat -c %u "${proc_dir}" 2>/dev/null || true)"
        [[ "${owner}" == "${uid}" ]] || continue
        env_text="$(tr '\0' '\n' < "${proc_env}" 2>/dev/null)" || continue

        if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
            value="$(env_value_from_text "${env_text}" XDG_RUNTIME_DIR)"
            if [[ -n "${value}" ]]; then
                XDG_RUNTIME_DIR="${value}"
                if (( ! gui_diagnostics_quiet )); then log "assuming XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}"; fi
            fi
        fi
        if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
            value="$(env_value_from_text "${env_text}" WAYLAND_DISPLAY)"
            if [[ -n "${value}" ]]; then
                WAYLAND_DISPLAY="${value}"
                if (( ! gui_diagnostics_quiet )); then log "assuming WAYLAND_DISPLAY=${WAYLAND_DISPLAY}"; fi
            fi
        fi
        if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
            value="$(env_value_from_text "${env_text}" DBUS_SESSION_BUS_ADDRESS)"
            if [[ -n "${value}" ]]; then
                DBUS_SESSION_BUS_ADDRESS="${value}"
                if (( ! gui_diagnostics_quiet )); then log "assuming DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}"; fi
            fi
        fi

        if [[ -n "${XDG_RUNTIME_DIR:-}" && -n "${WAYLAND_DISPLAY:-}" && \
              -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
            return 0
        fi
    done
}

infer_gui_common_environment() {
    infer_gui_environment_from_target_processes

    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        local runtime_dir=""
        runtime_dir="$(default_xdg_runtime_dir)" || true
        if [[ -n "${runtime_dir}" ]]; then
            XDG_RUNTIME_DIR="${runtime_dir}"
            if (( ! gui_diagnostics_quiet )); then log "assuming XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}"; fi
        fi
    fi

    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
        local dbus_socket_path="${XDG_RUNTIME_DIR}/bus"
        if [[ -S "${dbus_socket_path}" || -e "${dbus_socket_path}" ]]; then
            DBUS_SESSION_BUS_ADDRESS="unix:path=${dbus_socket_path}"
            if (( ! gui_diagnostics_quiet )); then log "assuming DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS}"; fi
        fi
    fi
}

find_wayland_display_in_runtime_dir() {
    local runtime_dir="$1"
    local candidate="${runtime_dir}/wayland-0"
    if [[ -S "${candidate}" || -e "${candidate}" ]]; then
        printf 'wayland-0'
        return 0
    fi

    for candidate in "${runtime_dir}"/wayland-*; do
        [[ "${candidate}" == *.lock ]] && continue
        [[ -S "${candidate}" || -e "${candidate}" ]] || continue
        basename "${candidate}"
        return 0
    done

    return 1
}

infer_gui_wayland_environment() {
    infer_gui_common_environment

    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        local runtime_dir=""
        runtime_dir="$(default_xdg_runtime_dir)" || true
        if [[ -n "${runtime_dir}" ]]; then
            XDG_RUNTIME_DIR="${runtime_dir}"
            if (( ! gui_diagnostics_quiet )); then log "assuming XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}"; fi
        elif [[ "${WAYLAND_DISPLAY:-}" == /* ]]; then
            XDG_RUNTIME_DIR="${WAYLAND_DISPLAY%/*}"
            if (( ! gui_diagnostics_quiet )); then log "assuming XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR}"; fi
        fi
    fi

    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        local display_name=""
        if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
            display_name="$(find_wayland_display_in_runtime_dir "${XDG_RUNTIME_DIR}")" || true
        fi

        if [[ -n "${display_name}" ]]; then
            WAYLAND_DISPLAY="${display_name}"
            if (( ! gui_diagnostics_quiet )); then log "assuming WAYLAND_DISPLAY=${WAYLAND_DISPLAY} from ${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"; fi
        else
            WAYLAND_DISPLAY="wayland-0"
            if (( ! gui_diagnostics_quiet )); then log "assuming WAYLAND_DISPLAY=${WAYLAND_DISPLAY}"; fi
        fi
    fi
}

resolve_wayland_socket_host_path() {
    [[ -n "${WAYLAND_DISPLAY:-}" ]] || return 1
    [[ -n "${XDG_RUNTIME_DIR:-}" ]] || return 1

    local candidate=""
    if [[ "${WAYLAND_DISPLAY}" == /* ]]; then
        candidate="${WAYLAND_DISPLAY}"
    elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
        candidate="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
    else
        return 1
    fi

    [[ -S "${candidate}" || -e "${candidate}" ]] || return 1
    printf '%s' "${candidate}"
}

resolve_gui_dbus_forwarding() {
    gui_dbus_socket_host_path=""
    gui_dbus_socket_container_path=""
    local dbus_socket_path=""
    dbus_socket_path="$(extract_dbus_session_bus_path "${DBUS_SESSION_BUS_ADDRESS:-}")"
    if [[ -n "${dbus_socket_path}" ]]; then
        if [[ -S "${dbus_socket_path}" || -e "${dbus_socket_path}" ]]; then
            gui_dbus_socket_host_path="${dbus_socket_path}"
            gui_dbus_socket_container_path="${gui_runtime_dir_container}/$(basename "${dbus_socket_path}")"
        else
            error "warning: DBUS session bus socket '${dbus_socket_path}' is unavailable; skipping DBUS session bus forwarding"
        fi
    fi
}

resolve_wayland_gui_session() {
    infer_gui_wayland_environment

    [[ -n "${WAYLAND_DISPLAY:-}" ]] \
        || die "--gui requires WAYLAND_DISPLAY to be set on the host"
    [[ -n "${XDG_RUNTIME_DIR:-}" ]] \
        || die "--gui requires XDG_RUNTIME_DIR to be set on the host"

    local wayland_socket_host_path=""
    wayland_socket_host_path="$(resolve_wayland_socket_host_path)" \
        || die "--gui requires the Wayland socket '${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}' to exist on the host"

    gui_platform="wayland"

    gui_wayland_socket_host_path="${wayland_socket_host_path}"
    gui_wayland_socket_container_path="${gui_runtime_dir_container}/$(basename "${wayland_socket_host_path}")"
    resolve_gui_dbus_forwarding
}

resolve_gui_session() {
    if (( ! gui_mode )); then
        return 0
    fi

    if [[ -n "${gui_platform}" ]]; then
        return 0
    fi

    resolve_wayland_gui_session
}

prepare_bind_mounts() {
    bind_mount_specs=()
    append_bind_mount /dev /dev rw
    if (( ! gui_mode )); then
        return 0
    fi

    resolve_gui_session

    if [[ -n "${gui_wayland_socket_host_path}" ]]; then
        append_bind_mount "${gui_wayland_socket_host_path}" "${gui_wayland_socket_container_path}" rw
    fi

    if [[ -n "${gui_dbus_socket_host_path}" ]]; then
        append_bind_mount "${gui_dbus_socket_host_path}" "${gui_dbus_socket_container_path}" rw
    fi

    if [[ -d /run/dbus ]]; then
        append_bind_mount /run/dbus /run/dbus rw
    fi
}

desired_container_runtime_label() {
    local -a spec_parts=(
        "image=$(image_id)"
        "privileged=1"
        "user=${uid}:${gid}"
        "home=/tmp/mmltk-home"
    )
    if (( gui_mode )); then
        resolve_gui_session
        spec_parts+=("gui=1")
        spec_parts+=("gui_platform=${gui_platform}")
        spec_parts+=("tmpfs=$(gui_runtime_tmpfs_spec)")
    else
        spec_parts+=("gui=0")
    fi

    local mount_spec
    for mount_spec in "${bind_mount_specs[@]}"; do
        spec_parts+=("mount=${mount_spec}")
    done

    local joined_spec
    printf -v joined_spec '%s|' "${spec_parts[@]}"
    printf '%s' "${joined_spec%|}"
}

rewrite_host_path() {
    local value="$1"
    if [[ "${value}" == /host/* ]]; then
        printf '%s' "${value}"
        return 0
    fi
    if [[ "${value}" == /* ]]; then
        printf '/host%s' "${value}"
        return 0
    fi
    printf '/host%s' "$(realpath -m -- "${host_workdir}/${value}")"
}

rewrite_benchmark_cache_path() {
    local value="$1"
    local host_value="${value}"
    if [[ "${host_value}" == /host/* ]]; then
        host_value="${host_value#/host}"
    elif [[ "${host_value}" != /* ]]; then
        host_value="${host_workdir}/${host_value}"
    fi
    host_value="$(realpath -m -- "${host_value}")"
    case "${host_value}" in
        "${repo_root}"|"${repo_root}/"*)
            ;;
        *)
            die "--cache-dir must stay within ${repo_root}"
            ;;
    esac
    printf '/host%s' "${host_value}"
}

is_path_option() {
    case "$1" in
        --source-dir|--output-dir|--cache-dir|--compiled|--weights|--class-layout|--resume|--onnx|--tensorrt|--output|--input|--save-engine|--report-json|--source|--train-compiled|--val-compiled|--test-compiled|--dist-store-file|--file|--start-at|--log-file|--log-dir|source_dir|output_dir|compiled)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

rewrite_passthrough_args() {
    rewritten_args=()
    local expect_path_value=0
    local expect_benchmark_cache_value=0
    local expect_tidy_file_values=0
    local arg
    for arg in "${passthrough_args[@]}"; do
        if (( expect_benchmark_cache_value )); then
            rewritten_args+=("$(rewrite_benchmark_cache_path "${arg}")")
            expect_benchmark_cache_value=0
            continue
        fi
        if (( expect_path_value )); then
            rewritten_args+=("$(rewrite_host_path "${arg}")")
            expect_path_value=0
            continue
        fi
        if (( expect_tidy_file_values )); then
            if [[ "${arg}" != --* ]]; then
                rewritten_args+=("$(rewrite_host_path "${arg}")")
                continue
            fi
            expect_tidy_file_values=0
        fi

        if [[ "${arg}" == --cache-dir=* ]]; then
            local cache_option_value="${arg#*=}"
            rewritten_args+=("--cache-dir=$(rewrite_benchmark_cache_path "${cache_option_value}")")
            continue
        fi

        if [[ "${arg}" == --cache-dir ]]; then
            rewritten_args+=("${arg}")
            expect_benchmark_cache_value=1
            continue
        fi

        if (( tidy_mode )) && [[ "${arg}" == --file ]]; then
            rewritten_args+=("${arg}")
            expect_tidy_file_values=1
            continue
        fi

        if [[ "${arg}" == --*=* ]]; then
            local option_name="${arg%%=*}"
            local option_value="${arg#*=}"
            if is_path_option "${option_name}"; then
                rewritten_args+=("${option_name}=$(rewrite_host_path "${option_value}")")
            else
                rewritten_args+=("${arg}")
            fi
            continue
        fi

        if is_path_option "${arg}"; then
            rewritten_args+=("${arg}")
            expect_path_value=1
            continue
        fi

        if [[ "${arg}" == /* ]]; then
            rewritten_args+=("$(rewrite_host_path "${arg}")")
            continue
        fi

        rewritten_args+=("${arg}")
    done
}

append_execution_policy_args() {
    local -n execution_args="$1"
    execution_args+=(--cap-add SYS_NICE --cap-add IPC_LOCK
        --ulimit memlock=-1:-1 --ulimit nice=40:40)
    # A present legacy backend is optional. DMA-BUF requires no gdrdrv node.
    if [[ -c /dev/gdrdrv ]]; then execution_args+=(--device /dev/gdrdrv); fi
}

append_native_environment() {
    local -n native_args="$1"
    local variable_name
    for variable_name in GDRCOPY_USE_DMABUF_MMAP GDRCOPY_ENABLE_LOGGING GDRCOPY_LOG_LEVEL \
        MMLTK_ANNOTATION_DIAGNOSTICS MMLTK_UPSCALE_ONNX_REFERENCE; do
        if [[ -n "${!variable_name:-}" ]]; then
            native_args+=(--env "${variable_name}=${!variable_name}")
        fi
    done
    for variable_name in MMLTK_GDR_TRACE_FILE MMLTK_NUMA_TRANSFER_TRACE_FILE; do
        if [[ -n "${!variable_name:-}" ]]; then
            native_args+=(--env "${variable_name}=$(rewrite_host_path "${!variable_name}")")
        fi
    done
}

append_native_logging_environment() {
    local -n logging_args="$1"
    local logging_mode="$2"
    shift 2
    local -A logging_values=() logging_entries=()
    local name value entry
    for name in MMLTK_LOG_LEVEL MMLTK_LOG_FILE MMLTK_LOG_DIR; do
        value="${!name:-}"
        if [[ -n "${value}" ]]; then
            if [[ "${name}" != MMLTK_LOG_LEVEL ]]; then
                value="$(rewrite_host_path "${value}")"
            fi
            logging_values["${name}"]="${value}"
            logging_entries["${name}"]="${name}=${value}"
        fi
    done
    if [[ "${logging_mode}" != exec ]]; then
        for entry in "${test_environment[@]}"; do
            name="${entry%%=*}"
            case "${name}" in
                MMLTK_LOG_LEVEL|MMLTK_LOG_FILE|MMLTK_LOG_DIR)
                    # Explicit test paths are already container paths. Bare names
                    # retain Docker's host-environment forwarding semantics.
                    value="${!name:-}"
                    if [[ "${entry}" == *=* ]]; then value="${entry#*=}"; fi
                    logging_values["${name}"]="${value}"
                    logging_entries["${name}"]="${entry}"
                    ;;
            esac
        done
    fi

    local effective_level="${logging_values[MMLTK_LOG_LEVEL]:-}"
    local accepted_level_pattern='^(trace|debug|info|warn|warning|error|err|critical|off)?$'
    # Native parsing rejects an invalid level before any later override applies.
    local level_valid=1
    [[ "${effective_level,,}" =~ ${accepted_level_pattern} ]] || level_valid=0
    local has_destination=0
    if [[ -n "${logging_values[MMLTK_LOG_FILE]:-}${logging_values[MMLTK_LOG_DIR]:-}" ]]; then
        has_destination=1
    fi
    # Mirror the native scan only to decide whether it needs a writable default.
    # Forward the original options unchanged; native parsing still owns errors.
    local option
    while (( level_valid && $# )); do
        option="$1"
        shift
        case "${option}" in
            --log-level=*|--log-file=*|--log-dir=*)
                value="${option#*=}"
                option="${option%%=*}"
                ;;
            --log-level|--log-file|--log-dir)
                (($#)) || continue
                value="$1"
                shift
                ;;
            *) continue ;;
        esac
        if [[ "${option}" == --log-level ]]; then
            # An empty native level override leaves the environment level intact.
            effective_level="${value:-${logging_values[MMLTK_LOG_LEVEL]:-}}"
            [[ "${effective_level,,}" =~ ${accepted_level_pattern} ]] || level_valid=0
        else
            has_destination=1
        fi
    done
    local enabled=0
    case "${effective_level,,}" in
        off) ;;
        "") if [[ "${logging_mode}" == wayland ]]; then enabled=1; fi ;;
        *) enabled="${level_valid}" ;;
    esac
    if (( enabled && ! has_destination )); then
        prepare_owned_dirs "${repo_root}/.mmltk-data/logs"
        value="$(rewrite_host_path "${repo_root}/.mmltk-data/logs")"
        if [[ "${logging_mode}" == wayland ]]; then value=/workspace/.mmltk-data/logs; fi
        logging_entries[MMLTK_LOG_DIR]="MMLTK_LOG_DIR=${value}"
    fi
    for name in MMLTK_LOG_LEVEL MMLTK_LOG_FILE MMLTK_LOG_DIR; do
        if [[ -v "logging_entries[${name}]" ]]; then
            logging_args+=(--env "${logging_entries[${name}]}")
        fi
    done
}

build_run_args() {
    run_args=(
        run
        -d
        --init
        --privileged
        --name "${container_name}"
        --entrypoint /bin/sh
        --gpus all
        --network host
        --ipc host
        --user "${uid}:${gid}"
        --env HOME=/tmp/mmltk-home
        --env NVIDIA_DRIVER_CAPABILITIES=all
        --label "com.mmltk.runtime=${desired_runtime_label}"
        --volume /:/host:rw
        --workdir "/host${repo_root}"
    )
    append_execution_policy_args run_args
    append_wrapper_labels run_args "${invocation_mode}"

    if (( gui_mode )); then
        run_args+=(--tmpfs "$(gui_runtime_tmpfs_spec)")
    fi

    build_common_group_args
    run_args+=("${common_group_args[@]}")

    local bind_mount_spec
    for bind_mount_spec in "${bind_mount_specs[@]}"; do
        run_args+=(--volume "${bind_mount_spec}")
    done

    run_args+=(
        "${image_name}"
        -lc
        'mkdir -p "${HOME}" && exec sleep infinity'
    )
}

build_common_group_args() {
    common_group_args=()

    local -a host_groups=()
    local group_lookup_user
    group_lookup_user="${MMLTK_USER:-}"
    if [[ -z "${group_lookup_user}" && ${uid} -ne $(id -u) ]]; then
        group_lookup_user="$(getent passwd "${uid}" | cut -d: -f1)"
    fi
    if [[ -n "${group_lookup_user}" ]]; then
        mapfile -t host_groups < <(id -G "${group_lookup_user}" | tr ' ' '\n' | sort -u)
    else
        mapfile -t host_groups < <(id -G | tr ' ' '\n' | sort -u)
    fi
    local group_id
    for group_id in "${host_groups[@]}"; do
        [[ -n "${group_id}" ]] || continue
        common_group_args+=(--group-add "${group_id}")
    done

    # Add the video group for V4L2 capture device access inside the container.
    # The host user may not be in the video group (ACLs grant access on the host
    # but are not carried through to the container).
    local video_gid
    video_gid="$(getent group video 2>/dev/null | cut -d: -f3)"
    if [[ -n "${video_gid}" ]]; then
        common_group_args+=(--group-add "${video_gid}")
    fi
}

ensure_gui_runtime_dir_access() {
    if (( ! gui_mode )); then
        return 0
    fi

    docker exec -u 0 "${container_name}" /bin/sh -lc "
        mkdir -p '${gui_runtime_dir_container}' &&
        chown '${uid}:${gid}' '${gui_runtime_dir_container}' &&
        chmod 700 '${gui_runtime_dir_container}'
    " >/dev/null
}

ensure_container() {
    ensure_docker
    ensure_image
    prepare_bind_mounts

    desired_runtime_label="$(desired_container_runtime_label)"
    if container_exists && [[ "$(container_runtime_label)" != "${desired_runtime_label}" ]]; then
        if (( ! gui_diagnostics_quiet )); then log "recreating ${container_name} for updated runtime configuration"; fi
        docker rm -f "${container_name}" >/dev/null 2>&1 || true
    fi

    if ! container_exists; then
        local -a run_args=()
        build_run_args
        docker "${run_args[@]}" >/dev/null
        return 0
    fi

    if ! container_running; then
        docker start "${container_name}" >/dev/null || true
    fi

    if ! container_running; then
        if (( ! gui_diagnostics_quiet )); then log "recreating ${container_name} because it did not stay running"; fi
        docker rm -f "${container_name}" >/dev/null 2>&1 || true
        local -a run_args=()
        build_run_args
        docker "${run_args[@]}" >/dev/null
    fi

    ensure_gui_runtime_dir_access
}

terminate_existing_gui_instances() {
    if (( ! gui_mode )); then
        return 0
    fi

    if docker exec -u 0 "${container_name}" /bin/sh -lc '
        pgrep -f "[m]mltk-browser-host" >/dev/null 2>&1
    ' >/dev/null 2>&1; then
        if (( ! gui_diagnostics_quiet )); then log "terminating existing GUI runtime before starting a new one"; fi
    fi

    shutdown_gui_runtime_in_container TERM 100 || true
}

verify_gui_contract_compatibility() {
    if (( ! gui_mode )); then
        return 0
    fi

    local served_asset_root="/opt/mmltk/share/mmltk/browser-app"
    docker exec "${container_name}" /bin/sh -lc '
        test -x /opt/mmltk/bin/mmltk-browser-host &&
        test -x /opt/mmltk/bin/mmltk-browser-bundle-contract &&
        test -x /opt/mmltk/lib/mmltk/firefox/firefox &&
        test -r "$1/index.html" &&
        test -s "$1/browser_protocol.marker"
    ' mmltk-contract-check "${served_asset_root}" \
        || die "runtime image is missing the packaged browser host, browser-bundle verifier, Firefox runtime, GUI assets, or native protocol marker; rebuild with ./mmltk --build"

    docker exec "${container_name}" \
        /opt/mmltk/bin/mmltk-browser-bundle-contract verify \
        "${served_asset_root}" "${served_asset_root}/browser_protocol.marker" \
        || die "the packaged GUI browser bundle contract is invalid or incompatible with the native host; rebuild with ./mmltk --build"
}

