        docker_args+=(-t)
    fi
    append_native_logging_environment docker_args test "$@"
    append_forwarded_test_environment docker_args
    append_explicit_test_environment docker_args
    docker_args+=("${common_group_args[@]}")
    if (( test_debugger )); then
        docker_args+=(--entrypoint /usr/bin/gdb "${build_image_name}")
        if [[ ! -t 0 || ! -t 1 ]]; then
            docker_args+=(--batch)
        fi
        local debugger_command
        for debugger_command in "${test_debugger_commands[@]}"; do
            docker_args+=(-ex "${debugger_command}")
        done
        if ((${#test_debugger_commands[@]} == 0)) && [[ ! -t 0 || ! -t 1 ]]; then
            docker_args+=(-ex run -ex bt)
        fi
        docker_args+=(--args "${executable}")
        docker_args+=("$@")
    else
        docker_args+=(--entrypoint "${executable}" "${build_image_name}")
        docker_args+=("$@")
    fi
    run_owned_docker_command "${test_run_container_name}" "${docker_args[@]}"
}

prepare_workspace_wayland_test_mounts() {
    bind_mount_specs=()
    append_bind_mount /dev /dev rw
    if (( test_headless_compositor )); then
        gui_platform="wayland"
        gui_wayland_socket_container_path="${gui_runtime_dir_container}/wayland-mmltk"
        return
    fi
    resolve_wayland_gui_session
    append_bind_mount "${gui_wayland_socket_host_path}" "${gui_wayland_socket_container_path}" rw
    if [[ -n "${gui_dbus_socket_host_path}" ]]; then
        append_bind_mount "${gui_dbus_socket_host_path}" "${gui_dbus_socket_container_path}" rw
    fi
    if [[ -d /run/dbus ]]; then
        append_bind_mount /run/dbus /run/dbus rw
    fi
}

ensure_wayland_validation_image() {
    local runtime_identity runtime_alias build_identity build_alias fingerprint
    runtime_identity="$(docker image inspect "${image_name}" --format '{{.Id}}')" ||
        die "headless compositor requires the packaged runtime image; run ./mmltk --build first"
    runtime_alias="$(content_derived_local_image_alias wayland-runtime "${runtime_identity}")"
    build_identity="$(docker image inspect "${build_image_name}" --format '{{.Id}}')" ||
        die "headless compositor requires the GCC 16.2 build image; run ./mmltk --build first"
    build_alias="$(content_derived_local_image_alias wayland-build "${build_identity}")"
    fingerprint="$({
        printf '%s\n' wayland-validation "${runtime_identity}" "${build_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.wayland-validation" \
            "${repo_root}/tools/headless_weston_seat.cpp"
    } | sha256sum | cut -d' ' -f1)"
    cached_buildx_image default - "${wayland_validation_image_name}" \
        "${repo_root}/docker/Dockerfile.wayland-validation" wayland-validation \
        "${fingerprint}" "${repo_root}" \
        --build-context "mmltk_runtime=docker-image://${runtime_alias}" \
        --build-context "mmltk_build=docker-image://${build_alias}" \
        --build-arg "MMLTK_RUNTIME_IDENTITY=${runtime_identity}" \
        --build-arg "MMLTK_BUILD_IDENTITY=${build_identity}"
    verify_content_derived_local_image_alias "${runtime_alias}" "${runtime_identity}"
    verify_content_derived_local_image_alias "${build_alias}" "${build_identity}"
    verify_image_label "${wayland_validation_image_name}" runtime-identity "${runtime_identity}"
    verify_image_label "${wayland_validation_image_name}" build-identity "${build_identity}"
}

run_headless_compositor_tool_tests() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker_server_ready || die "docker daemon is unavailable"
    local diagnostic_image_id
    diagnostic_image_id="$(docker image inspect "${build_image_name}" --format '{{.Id}}' 2>/dev/null)" ||
        die "headless compositor tooling requires existing image '${build_image_name}'"
    local diagnostic_container="${container_name}-headless-tool"
    local -a diagnostic_args=(
        run --rm --init --name "${diagnostic_container}"
        --read-only --cap-drop ALL --security-opt no-new-privileges
        --ulimit core=1:1
        --network none --user "${uid}:${gid}"
        --env PYTHONDONTWRITEBYTECODE=1
        --volume "${repo_root}:/workspace:ro"
        --tmpfs /tmp:rw,nosuid,nodev,size=32m
        --workdir /workspace --entrypoint /bin/bash
    )
    append_wrapper_labels diagnostic_args headless-compositor-tool
    diagnostic_args+=("${diagnostic_image_id}" -c
        'bash -n /workspace/mmltk && python3 -m unittest discover -s /workspace/tools/tests -p test_headless_compositor.py -v')
    run_owned_docker_command "${diagnostic_container}" "${diagnostic_args[@]}"
}

run_workspace_wayland_test_executable() {
    local executable="$1"
    shift

    docker image inspect "${image_name}" >/dev/null 2>&1 || die \
        "workspace-wayland requires the packaged runtime image; run ./mmltk --build first"
    prepare_owned_dirs \
        "${cache_root}/container-home" \
        "${cache_root}/tests/rfdetr" \
        "${repo_root}/build/validation"
    prepare_workspace_wayland_test_mounts
    build_common_group_args
    local -a docker_args=(
        run --rm --init -i
        --name "${test_run_container_name}"
        --privileged
        --gpus all
        --ipc host
        --network host
        --user "${uid}:${gid}"
        --tmpfs "$(gui_runtime_tmpfs_spec)"
        --env "HOME=${container_cache_root}/container-home"
        --env NVIDIA_DRIVER_CAPABILITIES=all
        --env MMLTK_REPO_ROOT=/workspace
        --env "MMLTK_RFDETR_TEST_CACHE_DIR=${container_cache_root}/tests/rfdetr"
        --env MMLTK_RUN_WORKSPACE_WAYLAND_INTEGRATION=1
        --env "XDG_SESSION_TYPE=${gui_platform}"
        --env "XDG_RUNTIME_DIR=${gui_runtime_dir_container}"
        --env GDK_BACKEND=wayland
        --env __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
        --env GBM_BACKEND=nvidia-drm
        --env "WAYLAND_DISPLAY=$(basename "${gui_wayland_socket_container_path}")"
        --volume "${repo_root}:/workspace:rw"
        --volume /:/host:rw
        --workdir /workspace
    )
    append_execution_policy_args docker_args
    append_native_environment docker_args
    append_wrapper_labels docker_args "${invocation_mode}"
    if [[ -t 0 && -t 1 ]]; then
        docker_args+=(-t)
    fi
    if [[ -n "${gui_dbus_socket_container_path}" && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        docker_args+=(
            --env "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS/unix:path=${gui_dbus_socket_host_path}/unix:path=${gui_dbus_socket_container_path}}"
        )
    fi
    if [[ -n "${__NV_PRIME_RENDER_OFFLOAD:-}" ]]; then
        docker_args+=(--env "__NV_PRIME_RENDER_OFFLOAD=${__NV_PRIME_RENDER_OFFLOAD}")
    fi
    append_native_logging_environment docker_args wayland "$@"
    if [[ -n "${MMLTK_GUI_TRACE_FILE:-}" ]]; then
        docker_args+=(--env "MMLTK_GUI_TRACE_FILE=$(rewrite_host_path "${MMLTK_GUI_TRACE_FILE}")")
    fi
    if [[ -n "${MMLTK_GUI_PIXEL_TRACE:-}" ]]; then
        docker_args+=(--env "MMLTK_GUI_PIXEL_TRACE=${MMLTK_GUI_PIXEL_TRACE}")
    fi
    if [[ -n "${MMLTK_FIREFOX_LOG_FILE:-}" ]]; then
        docker_args+=(--env "MMLTK_FIREFOX_LOG_FILE=$(rewrite_host_path "${MMLTK_FIREFOX_LOG_FILE}")")
    fi
    append_explicit_test_environment docker_args
    docker_args+=("${common_group_args[@]}")
    local bind_mount_spec
    for bind_mount_spec in "${bind_mount_specs[@]}"; do
        docker_args+=(--volume "${bind_mount_spec}")
    done
    if (( test_headless_compositor )) && [[ "${1:-}" != "--list-tests" ]]; then
        # Linux skips piped core handlers at exactly one byte; zero is ignored
        # by that path. Scope this to the validation container, not host sysctls.
        docker_args+=(
            --ulimit core=1:1
            --entrypoint /usr/bin/python3 "${wayland_validation_image_name}"
            /workspace/tools/headless_compositor.py -- "${executable}"
        )
    else
        docker_args+=(--entrypoint "${executable}" "${image_name}")
    fi
    docker_args+=("$@")
    local test_status=0
    active_headless_compositor="${test_headless_compositor}"
    run_owned_docker_command "${test_run_container_name}" "${docker_args[@]}" || test_status=$?
    active_headless_compositor=0
    return "${test_status}"
}

run_tests() {
    local suite="$1"
    shift
    if (( test_headless_compositor )) && [[ "${suite}" != "workspace-wayland" ]]; then
        die "--headless-compositor is only valid with --test workspace-wayland"
    fi

    if [[ "${suite}" == "list" || "${suite}" == "help" || "${suite}" == "-h" || "${suite}" == "--help" ]]; then
        (($# == 0)) || die "--test ${suite} does not accept additional arguments"
        print_test_suites
        return 0
    fi
    case "${suite}" in
        gui|tsan)
            die "--test ${suite} is unavailable in the native Catch2 test graph"
            ;;
    esac
    if [[ "${suite}" == "headless-compositor" || "${suite}" == "headless-compositor-tool" ]]; then
        (( ! test_config_explicit )) || die "--test ${suite} does not accept --config"
        [[ -z "${test_executable}" ]] || die "--test ${suite} does not accept --executable"
        (( ! test_debugger )) || die "--test ${suite} does not accept --gdb or --gdb-command"
        ((${#test_environment[@]} == 0)) || die "--test ${suite} does not accept --env"
        if [[ "${suite}" == "headless-compositor-tool" ]]; then
            (($# == 0)) || die "--test ${suite} does not accept additional arguments"
            run_headless_compositor_tool_tests
        else
            acquire_mutation_locks
            ensure_docker
            prepare_cache_layout
            ensure_wayland_validation_image
            test_headless_compositor=1
            local compositor_status=0
            if (($# == 0)); then set -- /usr/bin/true; fi
            run_workspace_wayland_test_executable "$@" || compositor_status=$?
            release_mutation_locks
            return "${compositor_status}"
        fi
        return
    fi
    if [[ "${suite}" == "browser-app" ]]; then
        [[ "${test_config}" == "release" ]] ||
            die "--test browser-app owns its GUI graph and does not accept --config"
        [[ -z "${test_executable}" ]] ||
            die "--test browser-app does not accept --executable"
        (( ! test_debugger )) ||
            die "--test browser-app does not accept --gdb"
        ((${#test_environment[@]} == 0)) ||
            die "--test browser-app does not yet consume native test environments"
        acquire_mutation_locks
        ensure_docker
        prepare_cache_layout
        ensure_build_image
        local browser_test_arguments=""
        local browser_test_argument
        for browser_test_argument in "$@"; do
            browser_test_argument="${browser_test_argument//;/\\;}"
            browser_test_arguments+="${browser_test_arguments:+;}${browser_test_argument}"
        done
        local browser_test_configuration
        printf -v browser_test_configuration '%q' "-DMMLTK_ICED_TEST_ARGUMENTS=${browser_test_arguments}"
        if (( ! gui_diagnostics_quiet )); then log "running iced browser application tests"; fi
        run_owned_toolchain_command "${test_run_container_name}" \
            'set -euo pipefail
             browser_test_icds=""
             for browser_test_icd in /etc/vulkan/icd.d/*nvidia*.json /usr/share/vulkan/icd.d/*nvidia*.json; do
                 if [[ -r "${browser_test_icd}" ]]; then
                     browser_test_icds+="${browser_test_icds:+:}${browser_test_icd}"
                 fi
             done
             if [[ -z "${browser_test_icds}" ]]; then
                 printf "%s\n" "browser-app GPU acceptance requires a container NVIDIA Vulkan ICD" >&2
                 exit 1
             fi
             export VK_DRIVER_FILES="${browser_test_icds}"
             /workspace/tools/configure_cmake_graph.sh \
                 gui "${MMLTK_CONTAINER_CACHE_ROOT}/cmake/gui" '"${browser_test_configuration}"'
             cmake --build "${MMLTK_CONTAINER_CACHE_ROOT}/cmake/gui" \
                 --parallel "${MMLTK_JOBS}" --target mmltk_frontend_iced_tests
             python3 /workspace/tools/check_toolchain_invariants.py \
                 --repo-root /workspace --build-dir "${MMLTK_CONTAINER_CACHE_ROOT}/cmake/gui"'
        release_mutation_locks
        return 0
    fi
    if [[ "${suite}" == "cleanup-tool" ]]; then
        (($# == 0)) || die "--test cleanup-tool does not accept additional arguments"
        (( ! test_config_explicit )) ||
            die "--test cleanup-tool does not accept --config"
        [[ -z "${test_executable}" ]] ||
            die "--test cleanup-tool does not accept --executable"
        (( ! test_debugger )) ||
            die "--test cleanup-tool does not accept --gdb or --gdb-command"
        ((${#test_environment[@]} == 0)) ||
            die "--test cleanup-tool does not accept --env"
        acquire_mutation_locks
        ensure_docker
        prepare_cache_layout
        ensure_build_image
        if (( ! gui_diagnostics_quiet )); then log "running cleanup tooling fixture tests"; fi
        run_owned_toolchain_command "${test_run_container_name}" \
            'set -euo pipefail
             node --test /workspace/tools/tests/generate_cleanup_json.test.mjs'
        release_mutation_locks
        return 0
    fi
    if [[ "${suite}" == "log-query-tool" ]]; then
        (($# == 0)) || die "--test log-query-tool does not accept additional arguments"
        (( ! test_config_explicit )) ||
            die "--test log-query-tool does not accept --config"
        [[ -z "${test_executable}" ]] ||
            die "--test log-query-tool does not accept --executable"
        (( ! test_debugger )) ||
            die "--test log-query-tool does not accept --gdb or --gdb-command"
        ((${#test_environment[@]} == 0)) ||
            die "--test log-query-tool does not accept --env"
        if (( ! gui_diagnostics_quiet )); then log "running log query tooling fixture tests"; fi
        run_log_tool test
        return 0
    fi
    if [[ "${suite}" == "rfdetr-profile" ]]; then
        if (( test_config_explicit )) && [[ "${test_config}" != "dev" ]]; then
            die "rfdetr-profile requires the instrumented dev configuration"
        fi
        test_config="dev"
    fi
    local -a targets=()
    local -a executables=()
    local configure_preset="${test_config}"
    local build_directory="${test_config}"
    local workspace_wayland_suite=0
    local cuda_vulkan_suite=0
    local -a suite_args=("$@")
    local -a all_native_test_targets=(
        mmltk_acceptance
        mmltk_backend_data_tests
        mmltk_backend_imaging_annotation_tests
        mmltk_backend_imaging_explore_tests
        mmltk_backend_imaging_upscale_tests
        mmltk_backend_media_live_tests
        mmltk_backend_ml_layers_tests
        mmltk_backend_ml_cuda_tests
        mmltk_backend_models_catalog_tests
        mmltk_backend_models_rfdetr_contract_tests
        mmltk_backend_models_rfdetr_core_tests
        mmltk_backend_models_rfdetr_augmentation_tests
        mmltk_backend_models_rfdetr_export_tests
        mmltk_backend_media_video_tests
        mmltk_backend_models_rfdetr_inference_tests
        mmltk_backend_models_rfdetr_training_tests
        mmltk_common_system_tests
        mmltk_common_concurrency_tests
        mmltk_controller_annotation_tests
        mmltk_controller_browser_tests
        mmltk_controller_visual_systems_tests
        mmltk_controller_services_tests
        mmltk_controller_shell_tests
        mmltk_controller_data_compute_systems_tests
        mmltk_entrypoints_cli_tests
        mmltk_entrypoints_desktop_tests
        mmltk_entrypoints_tools_tests
        mmltk_frameworks_gpu_tests
        mmltk_frameworks_process_tests
        mmltk_frameworks_serialization_tests
        mmltk_frameworks_transport_tests
        mmltk_workspace_wayland_integration
    )
    local -a all_native_test_executables=()
    local all_target
    for all_target in "${all_native_test_targets[@]}"; do
        [[ "${all_target}" == "mmltk_workspace_wayland_integration" ]] ||
            all_native_test_executables+=("${all_target}")
    done
    case "${suite}" in
        application-systems)
            targets=(
                mmltk_controller_browser_tests
                mmltk_controller_services_tests
                mmltk_controller_shell_tests
                mmltk_controller_data_compute_systems_tests
                mmltk_controller_visual_systems_tests
                mmltk_frameworks_gpu_tests
                mmltk_backend_media_live_tests
                mmltk_backend_media_video_tests
            )
            executables=("${targets[@]}")
            ;;
        application-contracts)
            targets=(
                mmltk_controller_browser_tests
                mmltk_controller_services_tests
                mmltk_controller_visual_systems_tests
                mmltk_frameworks_serialization_tests
            )
            executables=("${targets[@]}")
            ;;
        transport)
            targets=(mmltk_frameworks_transport_tests)
            executables=("${targets[@]}")
            ;;
        browser-runtime)
            targets=(mmltk_entrypoints_desktop_tests)
            executables=(mmltk_entrypoints_desktop_tests)
            ;;
        workspace-wayland)
            targets=(mmltk_workspace_wayland_integration)
            executables=(mmltk_workspace_wayland_integration)
            workspace_wayland_suite=1
            ;;
        cuda-vulkan)
            targets=(mmltk_cuda_vulkan_interop)
            executables=("${targets[@]}")
            cuda_vulkan_suite=1
            ;;
        core)
            targets=(
                mmltk_acceptance
                mmltk_backend_data_tests
                mmltk_backend_models_catalog_tests
                mmltk_common_system_tests
                mmltk_common_concurrency_tests
                mmltk_entrypoints_cli_tests
                mmltk_entrypoints_tools_tests
            )
            executables=("${targets[@]}")
            ;;
        rfdetr)
            targets=(
                mmltk_backend_ml_layers_tests
                mmltk_backend_ml_cuda_tests
                mmltk_backend_models_rfdetr_contract_tests
                mmltk_backend_models_rfdetr_core_tests
                mmltk_backend_models_rfdetr_augmentation_tests
                mmltk_backend_models_rfdetr_export_tests
                mmltk_backend_media_video_tests
                mmltk_backend_models_rfdetr_inference_tests
                mmltk_backend_models_rfdetr_training_tests
            )
            executables=("${targets[@]}")
            ;;
        rfdetr-profile)
            targets=(mmltk_rfdetr_train_profile_runner)
            executables=("${targets[@]}")
            ;;
        build)
            (($# == 0)) || die "--test build does not accept Catch2 arguments"
            targets=("${all_native_test_targets[@]}")
            ;;
        all)
            targets=("${all_native_test_targets[@]}")
            executables=("${all_native_test_executables[@]}")
            ;;
        *)
            print_test_suites >&2
            die "unknown test suite '${suite}'"
            ;;
    esac

    if [[ -n "${test_executable}" ]]; then
        local target_found=0
        local candidate
        for candidate in "${targets[@]}"; do
            if [[ "${candidate}" == "${test_executable}" ]]; then
                target_found=1
                break
            fi
        done
        (( target_found )) ||
            die "test executable '${test_executable}' is not owned by suite '${suite}'"
        targets=("${test_executable}")
        if [[ "${suite}" != "build" ]]; then
            local executable_found=0
            for candidate in "${executables[@]}"; do
                if [[ "${candidate}" == "${test_executable}" ]]; then
                    executable_found=1
                    break
                fi
            done
            (( executable_found )) ||
                die "target '${test_executable}' is not an executable in suite '${suite}'"
            executables=("${test_executable}")
        fi
    fi

    if (( workspace_wayland_suite )); then
        [[ "${test_config}" == "release" ]] ||
            die "workspace-wayland requires the packaged release graph"
        (( ! test_debugger )) ||
            die "workspace-wayland does not run through the build-image debugger"
    fi
    if (( cuda_vulkan_suite )); then
        [[ "${test_config}" == "release" ]] || die "cuda-vulkan requires the release graph"
        (( ! test_debugger )) || die "cuda-vulkan runs in the existing validation image without a debugger"
        ((${#test_environment[@]} == 0)) || die "cuda-vulkan accepts positional program arguments, not --env"
    fi
    if (( test_debugger )) && ((${#executables[@]} != 1)); then
        die "--gdb requires a suite with one executable or an explicit --executable"
    fi

    acquire_mutation_locks
    ensure_docker
    prepare_cache_layout
    ensure_build_image
    local browser_host_enabled=OFF
    local firefox_runtime_enabled=OFF
    if [[ "${test_config}" == "release" ]]; then
        prepare_firefox_build_input
        browser_host_enabled=ON
        firefox_runtime_enabled=ON
    fi
    local target_list="${targets[*]}"
    local test_inventory_audit=""
    if [[ "${suite}" == "all" || "${suite}" == "build" ]]; then
        local inventory_target_list="${all_native_test_targets[*]}"
        test_inventory_audit="python3 /workspace/tools/audit_test_inventory.py --compile-database \"\${MMLTK_CONTAINER_CACHE_ROOT}/cmake/${build_directory}/compile_commands.json\" --repo-root /workspace --expected-targets \"${inventory_target_list}\""
    fi
    if (( ! gui_diagnostics_quiet )); then log "building cached ${suite} test graph with ${build_jobs} workers"; fi
    run_owned_toolchain_command "${test_build_container_name}" \
        "set -euo pipefail
         /workspace/tools/configure_cmake_graph.sh \
             ${configure_preset} \"\${MMLTK_CONTAINER_CACHE_ROOT}/cmake/${build_directory}\" \
             -DBUILD_MMLTK_BROWSER_HOST=${browser_host_enabled} \
             -DBUILD_MMLTK_FIREFOX_RUNTIME=${firefox_runtime_enabled} \
             -DMMLTK_BUILD_JOBS=\"\${MMLTK_JOBS}\" \
             -DMMLTK_FIREFOX_CACHE_ROOT=\"\${MMLTK_FIREFOX_CACHE_ROOT}\"
         ${test_inventory_audit}
         cmake --build \"\${MMLTK_CONTAINER_CACHE_ROOT}/cmake/${build_directory}\" \
             --parallel \"\${MMLTK_JOBS}\" --target ${target_list}
         python3 /workspace/tools/check_toolchain_invariants.py \
             --repo-root /workspace --build-dir \"\${MMLTK_CONTAINER_CACHE_ROOT}/cmake/${build_directory}\""

    if (( cuda_vulkan_suite )); then
        ensure_wayland_validation_image
        local diagnostic_status=0
        run_gpu_diagnostic_executable "${cmake_cache_root}/${build_directory}/${executables[0]}" \
            "${suite_args[@]}" || diagnostic_status=$?
        release_mutation_locks
        return "${diagnostic_status}"
    fi
    if (( workspace_wayland_suite )); then
        if (( test_headless_compositor )); then
            ensure_wayland_validation_image
        fi
        local workspace_wayland_inventory=""
        local -a workspace_wayland_expected_cases=(
            workspace_wayland_retained
            workspace_wayland_dpi
            workspace_wayland_terminal
            workspace_wayland_probe_recovery
            workspace_wayland_gdr
            workspace_wayland_quiet
        )
        if (( ! gui_diagnostics_quiet )); then log "enumerating ${executables[0]} hardware cases"; fi
        if ! workspace_wayland_inventory="$(
            run_workspace_wayland_test_executable \
                "${container_cache_root}/cmake/${build_directory}/${executables[0]}" \
                --list-tests
        )"; then
            release_mutation_locks
            die "workspace-wayland test enumeration failed"
        fi
        printf '%s\n' "${workspace_wayland_inventory}"
        local workspace_wayland_case
        for workspace_wayland_case in "${workspace_wayland_expected_cases[@]}"; do
            [[ "${workspace_wayland_inventory}" == *"${workspace_wayland_case}"* ]] || {
                release_mutation_locks
                die "workspace-wayland executable is missing expected hardware case '${workspace_wayland_case}'"
            }
        done
        if (( ! gui_diagnostics_quiet )); then log "running ${executables[0]}"; fi
        local workspace_wayland_status=0
        if run_workspace_wayland_test_executable \
                "${container_cache_root}/cmake/${build_directory}/${executables[0]}" \
                "${suite_args[@]}"; then
            :
        else
            workspace_wayland_status=$?
        fi
        release_mutation_locks
        return "${workspace_wayland_status}"
    fi

    local first_failure=0
    local executable
    for executable in "${executables[@]}"; do
        if (( ! gui_diagnostics_quiet )); then log "running ${executable}"; fi
        local exit_status=0
        local -a executable_args=("${suite_args[@]}")
        if run_test_executable "${container_cache_root}/cmake/${build_directory}/${executable}" "${executable_args[@]}"; then
            continue
        else
            exit_status=$?
        fi
        if (( first_failure == 0 )); then
            first_failure="${exit_status}"
        fi
        if [[ "${suite}" != "all" ]]; then
            release_mutation_locks
            return "${exit_status}"
        fi
    done
    release_mutation_locks
    return "${first_failure}"
}

prepare_release_build_environment() {
    acquire_mutation_locks
    ensure_docker
    prepare_cache_layout
}

run_build() {
    acquire_mutation_locks
    initialize_build_trace
    trace_build_event build start
    trace_build_job_assignment
    trace_failed_build() {
        local exit_status=$?
        trap - ERR
        trace_build_event build finish "failure:${exit_status}"
        return "${exit_status}"
    }
    trap trace_failed_build ERR
    run_traced_build_phase bootstrap prepare_release_build_environment
    prepare_image_producers
    image_producers_prepared=1
    buildx_builder_ready=1
    default_engine_builder_ready=1
    active_build_container_names=("${release_build_container_name}")
    docker rm -f "${release_build_container_name}" >/dev/null 2>&1 || true
    run_traced_build_phase release_ninja run_release_branch &
    track_build_pid "$!"
    run_traced_build_phase runtime_base ensure_runtime_base_image &
    track_build_pid "$!"
    if wait_for_parallel_builds; then
        :
    else
        local exit_status=$?
        trap - ERR
        trace_build_event build finish "failure:${exit_status}"
        return "${exit_status}"
    fi
    run_traced_build_phase package stage_release_and_runtime
    release_mutation_locks
    trace_build_event build finish success
    trap - ERR
}

