fingerprint_path() {
    local root="$1"
    if [[ -d "${root}" ]]; then
        (
            cd "${root}"
            printf 'directory\0'
            local relative_path
            while IFS= read -r -d '' relative_path; do
                printf '%s\0%s\0' "$(stat -c '%a' -- "${relative_path}")" "${relative_path}"
                if [[ -L "${relative_path}" ]]; then
                    printf 'link\0%s\0' "$(readlink -- "${relative_path}")"
                else
                    sha256sum -- "${relative_path}" | cut -d' ' -f1
                fi
            done < <(find . \( -type f -o -type l \) -print0 | sort -z)
        ) | sha256sum | cut -d' ' -f1
    elif [[ -f "${root}" || -L "${root}" ]]; then
        {
            printf 'file\0%s\0' "$(stat -c '%a' -- "${root}")"
            if [[ -L "${root}" ]]; then
                printf 'link\0%s\0' "$(readlink -- "${root}")"
            else
                sha256sum -- "${root}" | cut -d' ' -f1
            fi
        } | sha256sum | cut -d' ' -f1
    else
        printf 'missing\n' | sha256sum | cut -d' ' -f1
    fi
}

release_package_hash_source() {
    local path="$1" destination="$2" source_kind="$3" source_path="$4"
    shift 4
    local source_root entry fingerprint
    case "${source_kind}" in
        release) source_root="${cmake_cache_root}/release" ;;
        repository) source_root="${repo_root}/${source_path}" ;;
        firefox) source_root="${firefox_cache_root}/obj-minimal-opt/dist/firefox" ;;
        browser) source_root="${release_frontend_dist_dir}" ;;
        image) return ;; # The enclosing fingerprint owns the exact toolchain image.
        *) die "unknown runtime package source '${source_kind}'" ;;
    esac
    if [[ "${source_kind}" == release || "${source_kind}" == repository ]]; then
        for entry in "$@"; do
            entry="${entry#\?}"
            fingerprint="$(runtime_package_path_fingerprint "${source_root}/${entry}")" || return
            printf '%s/%s %s\n' "${path}" "${entry}" \
                "${fingerprint}"
        done
    else
        fingerprint="$(runtime_package_path_fingerprint "${source_root}")" || return
        printf '%s %s\n' "${path}" "${fingerprint}"
        if [[ "${source_kind}" == browser ]]; then
            fingerprint="$(runtime_package_path_fingerprint \
                "${cmake_cache_root}/release/${source_path}")" || return
            printf '%s %s\n' "${source_path}" "${fingerprint}"
        fi
    fi
}

release_package_fingerprint() {
    local release_root="${cmake_cache_root}/release"
    local toolchain_identity
    toolchain_identity="$(docker image inspect "${build_image_name}" --format '{{.Id}}')"
    {
        printf 'mmltk-release-package-v7\n%s\n' "${toolchain_identity}"
        sha256sum "${repo_root}/tools/runtime_package.sh"
        runtime_package_inventory release_package_hash_source || return
        local output_path
        while IFS= read -r -d '' output_path; do
            printf '%s %s\n' "${output_path#"${release_root}/"}" \
                "$(fingerprint_path "${output_path}")"
        done < <(find "${release_root}" -type f -name cmake_install.cmake -print0 | sort -z)
    } | sha256sum | cut -d' ' -f1
}

browser_host_release_enabled() {
    local ninja_graph="${cmake_cache_root}/release/build.ninja"
    local cmake_cache="${cmake_cache_root}/release/CMakeCache.txt"
    [[ -f "${ninja_graph}" && -f "${cmake_cache}" ]] \
        && grep -Fq 'build mmltk_frontend_iced_bundle: phony' "${ninja_graph}" \
        && grep -Fq 'BUILD_MMLTK_BROWSER_HOST:BOOL=ON' "${cmake_cache}" \
        && grep -Fq 'BUILD_MMLTK_FIREFOX_RUNTIME:BOOL=ON' "${cmake_cache}"
}

runtime_image_fingerprint() {
    local stage_root="$1"
    local runtime_base_identity="$2"
    {
        printf 'mmltk-runtime-image-v5\n%s\n' "${runtime_base_identity}"
        sha256sum "${repo_root}/docker/Dockerfile.runtime" \
            "${repo_root}/tools/runtime_package.sh"
        runtime_package_fingerprint "${stage_root}"
    } | sha256sum | cut -d' ' -f1
}

build_runtime_image() {
    local stage_root="$1"
    runtime_package_complete "${stage_root}" || die "staged release is incomplete or contains test executables"
    local runtime_base_identity
    runtime_base_identity="$(docker image inspect "${runtime_base_image_name}" --format '{{.Id}}')"
    initialize_nvidia_inputs
    verify_nvidia_image_labels "${runtime_base_image_name}" runtime
    local release_fingerprint
    release_fingerprint="$(runtime_image_fingerprint \
        "${stage_root}" "${runtime_base_identity}")"
    local runtime_base_alias
    runtime_base_alias="$(content_derived_local_image_alias runtime-base "${runtime_base_identity}")"
    cached_buildx_image default - "${image_name}" \
        "${repo_root}/docker/Dockerfile.runtime" runtime "${release_fingerprint}" "${stage_root}" \
        --build-context "mmltk_package=${repo_root}/tools" \
        --build-arg "MMLTK_RUNTIME_BASE_IMAGE=${runtime_base_alias}" \
        --build-arg "MMLTK_RELEASE_FINGERPRINT=${release_fingerprint}" \
        --build-arg "MMLTK_RUNTIME_BASE_IDENTITY=${runtime_base_identity}"
    verify_content_derived_local_image_alias "${runtime_base_alias}" "${runtime_base_identity}"
    local current_release_fingerprint current_runtime_base_identity
    current_release_fingerprint="$(docker image inspect "${image_name}" \
        --format '{{ index .Config.Labels "com.mmltk.release-fingerprint" }}')"
    current_runtime_base_identity="$(docker image inspect "${image_name}" \
        --format '{{ index .Config.Labels "com.mmltk.runtime-base-identity" }}')"
    [[ "${current_release_fingerprint}" == "${release_fingerprint}" ]] || die \
        "runtime image release fingerprint label does not match staged outputs"
    [[ "${current_runtime_base_identity}" == "${runtime_base_identity}" ]] || die \
        "runtime image base identity label does not match ${runtime_base_image_name}"
    verify_nvidia_image_labels "${image_name}" runtime
}

build_configured_runtime_image() {
    local stage_root="$1"
    browser_host_release_enabled \
        || die "release graph must enable the browser host, browser app, and owned Firefox runtime"
    build_runtime_image "${stage_root}"
}

stage_release_and_runtime() {
    local package_fingerprint
    package_fingerprint="$(release_package_fingerprint)"
    if runtime_package_complete "${release_stage_root}" \
        && [[ -f "${release_stage_root}/.mmltk-package-fingerprint" ]] \
        && [[ "$(<"${release_stage_root}/.mmltk-package-fingerprint")" == "${package_fingerprint}" ]]; then
        if (( ! gui_diagnostics_quiet )); then log "staged release is current"; fi
        trace_build_event package cache_hit
        build_configured_runtime_image "${release_stage_root}"
        return
    fi

    trace_build_event package cache_miss
    local next_stage="${release_stage_root}.next"
    export MMLTK_PACKAGE_FINGERPRINT="${package_fingerprint}"
    if (( ! gui_diagnostics_quiet )); then log "installing release into ${next_stage}"; fi
    run_owned_toolchain_command "${package_build_container_name}" \
        'set -euo pipefail
         next_stage="${MMLTK_CONTAINER_RELEASE_STAGE_ROOT}.next"
         rm -rf -- "${next_stage}"
         cmake --install "${MMLTK_CONTAINER_CACHE_ROOT}/cmake/release" \
             --prefix "${next_stage}"
         printf "%s\n" "${MMLTK_PACKAGE_FINGERPRINT}" >"${next_stage}/.mmltk-package-fingerprint"'
    unset MMLTK_PACKAGE_FINGERPRINT
    runtime_package_complete "${next_stage}" || die "staged release is incomplete"
    [[ -f "${next_stage}/.mmltk-package-fingerprint" \
        && "$(<"${next_stage}/.mmltk-package-fingerprint")" == "${package_fingerprint}" ]] \
        || die "staged release fingerprint is incomplete"

    build_configured_runtime_image "${next_stage}"
    local previous_stage="${release_stage_root}.previous"
    rm -rf -- "${previous_stage}"
    if [[ -e "${release_stage_root}" ]]; then
        mv "${release_stage_root}" "${previous_stage}"
    fi
    mv "${next_stage}" "${release_stage_root}"
    rm -rf -- "${previous_stage}"
}

wait_for_parallel_builds() {
    local remaining="${#active_build_pids[@]}"
    local exit_status=0
    while (( remaining > 0 )); do
        if wait -n; then
            remaining=$((remaining - 1))
        else
            exit_status=$?
            error "parallel build job failed with exit status ${exit_status}; stopping its peer"
            terminate_active_builds
            return "${exit_status}"
        fi
    done
    active_build_pids=()
    active_build_start_ticks=()
    active_build_container_names=()
}

