toolchain_base_image_name="${MMLTK_TOOLCHAIN_BASE_IMAGE:-mmltk-toolchain-base:latest}"
gcc16_image_name="${MMLTK_GCC_IMAGE:-mmltk-gcc16:latest}"
nvidia_payload_image_name="${MMLTK_NVIDIA_PAYLOAD_IMAGE:-mmltk-nvidia-payload:latest}"
