            die "--cleanup-report does not accept additional arguments"
        cleanup_report_profile="${passthrough_args[0]#--cleanup-report=}"
        [[ -n "${cleanup_report_profile}" ]] ||
            die "--cleanup-report requires cpp, frontend, or all"
        passthrough_args=()
    fi
fi

if (( ! diagnose_io_mode )); then
    for arg in "${passthrough_args[@]}"; do
        [[ "${arg}" != "--diagnose-io" ]] ||
            die "--diagnose-io must be the standalone operation before its compiled-file path"
    done
fi

if (( ! diagnose_nvidia_mode )); then
    for arg in "${passthrough_args[@]}"; do
        [[ "${arg}" != "--diagnose-nvidia-payload" ]] ||
            die "--diagnose-nvidia-payload must be the standalone operation before its source and public header filenames"
    done
fi

if (( ! cleanup_report_mode )); then
    for arg in "${passthrough_args[@]}"; do
        if [[ "${arg}" == "--cleanup-report" || "${arg}" == --cleanup-report=* ]]; then
