run_gpu_program_diagnostic() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        printf '%s\n' \
            'Usage: ./mmltk --diagnose-gpu-program SOURCE.cpp [PROGRAM_ARGS...]' \
            'Build one standalone C++26 CUDA-driver/Vulkan diagnostic in the existing development image.' \
            'Run it in the existing Wayland validation image, without starting the application or compositor.' \
            'Artifacts go under build/diagnostics; no image builds, pulls, or network.' \
            'Compilation and execution each have a 120-second deadline.'
        return 0
    fi
    (( $# >= 1 )) || die "--diagnose-gpu-program requires a C++ source path"
    local program_source program_directory artifact_directory build_id
    program_source="$(realpath -e -- "$1")" || die "diagnostic source does not exist: $1"
    shift
    [[ -f "${program_source}" && -r "${program_source}" && "${program_source}" == *.cpp ]] ||
        die "--diagnose-gpu-program requires a readable .cpp file"
    [[ "${program_source}" != *:* ]] || die "diagnostic source path cannot contain ':'"
    program_directory="$(dirname -- "${program_source}")"
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker_server_ready || die "docker daemon is unavailable; diagnostic did not start"
    build_id="$(docker image inspect "${build_image_name}" --format '{{.Id}}' 2>/dev/null)" ||
        die "diagnostic requires existing image '${build_image_name}'"
    docker image inspect "${wayland_validation_image_name}" >/dev/null 2>&1 ||
        die "diagnostic requires existing image '${wayland_validation_image_name}'"
    prepare_owned_dirs "${repo_root}/build/diagnostics"
    artifact_directory="$(mktemp -d "${repo_root}/build/diagnostics/gpu-program.XXXXXX")"
    chown "${uid}:${gid}" "${artifact_directory}"
    local diagnostic_container="${container_name}-gpu-program"
    local -a compile_args=(
        run --rm --init --pull never --name "${diagnostic_container}-build"
        --read-only --cap-drop ALL --security-opt no-new-privileges --network none
        --user "${uid}:${gid}" --tmpfs /tmp:rw,nosuid,nodev,size=256m
        --volume "${program_directory}:/diagnostic/source:ro"
        --volume "${artifact_directory}:/diagnostic/output:rw"
        --env "MMLTK_DIAGNOSTIC_SOURCE=$(basename -- "${program_source}")"
        --entrypoint /usr/bin/timeout
    )
    append_wrapper_labels compile_args "diagnose-gpu-program"
    log "standalone diagnostic artifacts: ${artifact_directory}"
    run_owned_docker_command "${diagnostic_container}-build" "${compile_args[@]}" \
        "${build_id}" --signal=KILL 120s /bin/bash -c '
            exec /opt/gcc-16.2/bin/g++ -std=c++26 -O2 -g -Wall -Wextra \
                -Wno-missing-field-initializers \
                -I"${CUDA_HOME}/include" "/diagnostic/source/${MMLTK_DIAGNOSTIC_SOURCE}" \
                -L"${CUDA_HOME}/lib64/stubs" -lcuda -lvulkan \
                -o /diagnostic/output/probe
        '
    run_gpu_diagnostic_executable "${artifact_directory}/probe" "$@"
}

run_gpu_diagnostic_executable() {
