run_nvidia_payload_diagnostic() {
    local source="$1"
    shift
    local diagnostic_image diagnostic_image_id
    case "${source}" in
        donor) diagnostic_image="$(manifest_value donor)" ;;
        development) diagnostic_image="${build_image_name}" ;;
        *) die "--diagnose-nvidia-payload requires donor or development, followed by public header filenames" ;;
    esac
    local header
    for header in "$@"; do
        [[ "${header}" =~ ^[A-Za-z0-9_.-]+$ ]] ||
            die "NVIDIA diagnostic headers must be public filenames, without directory paths"
    done
    if [[ "${source}" == donor ]]; then
        local header_list output_directory="${repo_root}/build/diagnostics/nvidia-payload"
        printf -v header_list '%s,' "$@"
        acquire_mutation_locks
        ensure_docker
        ensure_buildx_builder
        prepare_owned_dirs "${output_directory}"
        docker buildx build --builder "${buildx_builder_name}" --progress=plain \
            --file "${repo_root}/docker/Dockerfile.nvidia-diagnostic" \
            --build-arg "MMLTK_NVIDIA_DONOR_IMAGE=${diagnostic_image}" \
            --build-arg "MMLTK_DIAGNOSTIC_HEADERS=${header_list%,}" \
            --output "type=local,dest=${output_directory}" "${repo_root}" >&2
        cat "${output_directory}/headers.json"
        release_mutation_locks
        return 0
    fi
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker_server_ready || die "docker daemon is unavailable; diagnostic did not start"
    diagnostic_image_id="$(docker image inspect "${diagnostic_image}" --format '{{.Id}}' 2>/dev/null)" ||
        die "diagnostic requires existing image '${diagnostic_image}'; no image was built or pulled"
    if (( ! gui_diagnostics_quiet )); then log "read-only NVIDIA header inventory in ${diagnostic_image}"; fi
    docker run --rm --init --read-only --cap-drop ALL --security-opt no-new-privileges \
        --network none --user "${uid}:${gid}" \
        --env PYTHONDONTWRITEBYTECODE=1 \
        --env "MMLTK_DIAGNOSTIC_IMAGE=${diagnostic_image}" \
        --env "MMLTK_DIAGNOSTIC_IMAGE_ID=${diagnostic_image_id}" \
        --volume "${repo_root}/tools/diagnose_nvidia_payload.py:/diagnostic/report.py:ro" \
        --volume "${repo_root}/docker:/diagnostic_metadata:ro" \
        --entrypoint python3 "${diagnostic_image_id}" /diagnostic/report.py "$@"
}

