        --env CCACHE_BASEDIR=/workspace
        --env "CCACHE_DIR=${container_cache_root}/ccache"
        --env "CCACHE_TEMPDIR=${container_cache_root}/ccache/tmp"
        --env CCACHE_NOHASHDIR=1
        --env CCACHE_MAXSIZE=50G
        --env CCACHE_SLOPPINESS=pch_defines,time_macros
        --env "MMLTK_CONTAINER_CACHE_ROOT=${container_cache_root}"
        --env "MMLTK_CONTAINER_RELEASE_STAGE_ROOT=${container_release_stage_root}"
        --env "MMLTK_FIREFOX_CACHE_ROOT=${container_cache_root}/firefox"
        --env "MMLTK_JOBS=${build_jobs}"
        --env "MMLTK_TOOLCHAIN_ID=${toolchain_identity}"
        --env "MOZBUILD_STATE_PATH=${container_cache_root}/firefox/mozbuild"
        --env "SCCACHE_BASEDIRS=${container_firefox_sccache_basedirs}"
        --env "SCCACHE_DIR=${container_cache_root}/firefox/sccache"
        --env SCCACHE_CACHE_SIZE=20G
        --volume "${repo_root}:/workspace:rw"
        --workdir /workspace
        --entrypoint /bin/bash
    )
    append_wrapper_labels docker_args "${invocation_mode}"
    if [[ -n "${owned_container_name}" ]]; then
        docker_args+=(--name "${owned_container_name}")
    fi
    if [[ -n "${MMLTK_PACKAGE_FINGERPRINT:-}" ]]; then
        docker_args+=(--env "MMLTK_PACKAGE_FINGERPRINT=${MMLTK_PACKAGE_FINGERPRINT}")
    fi
    if [[ -n "${container_ccache_stats_file}" ]]; then
        docker_args+=(--env "MMLTK_CCACHE_STATS_FILE=${container_ccache_stats_file}")
    fi
    if [[ -n "${container_firefox_sccache_stats_file}" ]]; then
        docker_args+=(--env \
            "MMLTK_FIREFOX_SCCACHE_STATS_FILE=${container_firefox_sccache_stats_file}")
    fi
    if [[ -n "${container_build_trace_file}" ]]; then
        docker_args+=(--env "MMLTK_BUILD_TRACE_FILE=${container_build_trace_file}")
    fi
    if [[ -n "${container_firefox_stage_trace_file}" ]]; then
        docker_args+=(--env \
            "MMLTK_FIREFOX_STAGE_LOG_FILE=${container_firefox_stage_trace_file}")
    fi
    if [[ "${invocation_mode}" == "export-shiftlut" ]]; then
        docker_args+=(--volume "${shiftlut_source}:/shiftlut-source:ro")
        docker_args+=(--env "MMLTK_SHIFTLUT_MODE=${shiftlut_operation}")
        if [[ "${shiftlut_operation}" == "--verify-only" ]]; then
            docker_args+=(--gpus all --env NVIDIA_DRIVER_CAPABILITIES=compute,utility)
        fi
    fi
    if [[ "${invocation_mode}" == "test" && "${test_suite}" == "browser-app" ]]; then
        docker_args+=(--gpus all --env NVIDIA_DRIVER_CAPABILITIES=graphics,utility --env WGPU_BACKEND=vulkan)
    fi
    docker_args+=("${build_image_name}" -lc "${command}")
    docker "${docker_args[@]}"
}

firefox_source_state_fingerprint_for() {
    local format="$1"
    local build_definition="$2"
    local toolchain_identity="$3"
    {
        printf '%s\0%s\0' "${format}" "${toolchain_identity}"
        printf 'desktop-build-definition\0%s\0' \
            "$(fingerprint_path "${build_definition}")"
        printf 'firefox-build-command\0%s\0' \
            "$(fingerprint_path \
                "${repo_root}/src/entrypoints/desktop/build_firefox_runtime.sh")"
        local graphics_input
        for graphics_input in \
            src/controller/presentation/detail/workspace_surface_import_abi.h \
            src/controller/presentation/detail/workspace_frame_signal.h \
            src/controller/presentation/workspace_presentation_types.h \
            src/frameworks/gpu/image_workspace.h \
            src/controller/browser/application_workspace_abi_emitter.h \
            src/controller/browser/application_binding_generator.cpp \
            src/controller/browser/CMakeLists.txt; do
            printf 'graphics-input\0%s\0%s\0' "${graphics_input}" \
                "$(fingerprint_path "${repo_root}/${graphics_input}")"
        done
        git -C "${repo_root}" rev-parse HEAD:third_party/firefox
        git -C "${repo_root}" diff --no-ext-diff --binary \
            HEAD -- third_party/firefox
        local untracked_path
        while IFS= read -r -d '' untracked_path; do
            printf 'untracked\0%s\0%s\0' "${untracked_path}" \
                "$(fingerprint_path "${repo_root}/${untracked_path}")"
        done < <(git -C "${repo_root}" ls-files --others \
            --exclude-standard -z -- third_party/firefox)
    } | sha256sum | cut -d' ' -f1
}

firefox_source_state_fingerprint() {
