parse_test_invocation_args() {
    local -a raw_args=("$@")
    test_args=()
    local index=0
    while (( index < ${#raw_args[@]} )); do
        local argument="${raw_args[index]}"
        case "${argument}" in
            --)
                test_args+=("${raw_args[@]:index+1}")
                return
                ;;
            --config)
                (( index + 1 < ${#raw_args[@]} )) ||
                    die "--config requires release or dev"
                test_config="${raw_args[index+1]}"
                test_config_explicit=1
                ((index += 2))
                ;;
            --executable)
                (( index + 1 < ${#raw_args[@]} )) ||
                    die "--executable requires a target name"
                test_executable="${raw_args[index+1]}"
                ((index += 2))
                ;;
            --env)
                (( index + 1 < ${#raw_args[@]} )) ||
                    die "--env requires NAME or NAME=VALUE"
                local environment_entry="${raw_args[index+1]}"
                local environment_name="${environment_entry%%=*}"
                [[ "${environment_name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
                    die "invalid --env name '${environment_name}'"
                test_environment+=("${environment_entry}")
                ((index += 2))
                ;;
            --gdb)
                test_debugger=1
                ((index += 1))
                ;;
            --headless-compositor)
                test_headless_compositor=1
                ((index += 1))
                ;;
            --gdb-command)
                (( index + 1 < ${#raw_args[@]} )) ||
                    die "--gdb-command requires one GDB command"
                test_debugger=1
                test_debugger_commands+=("${raw_args[index+1]}")
                ((index += 2))
                ;;
            *)
                test_args+=("${argument}")
                ((index += 1))
                ;;
        esac
    done
}

